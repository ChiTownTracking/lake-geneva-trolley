---
/** Small stroked icon set, sized by the caller via CSS. */
interface Props {
	name:
		| 'phone'
		| 'mail'
		| 'pin'
		| 'chat'
		| 'arrow-left'
		| 'arrow-right'
		| 'instagram'
		| 'facebook';
	class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
	phone:
		'M6.6 2.5 8.4 6l-1.7 1.7a12 12 0 0 0 5.6 5.6L14 11.6l3.5 1.8v3.1a1.5 1.5 0 0 1-1.7 1.5A14.5 14.5 0 0 1 3 6.2 1.5 1.5 0 0 1 4.5 4.5h2.1Z',
	mail: 'M2.5 5.5h15v9h-15zM2.5 5.5 10 11l7.5-5.5',
	pin: 'M10 18s6-5.2 6-9.5A6 6 0 0 0 4 8.5C4 12.8 10 18 10 18Z M10 10.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
	chat: 'M3 4.5h14v9H8l-4 3.5v-3.5H3z',
	'arrow-left': 'M12.5 4 6.5 10l6 6',
	'arrow-right': 'M7.5 4l6 6-6 6',
	instagram:
		'M6.6 3h6.8A3.6 3.6 0 0 1 17 6.6v6.8a3.6 3.6 0 0 1-3.6 3.6H6.6A3.6 3.6 0 0 1 3 13.4V6.6A3.6 3.6 0 0 1 6.6 3Z M12.9 10a2.9 2.9 0 1 1-5.8 0 2.9 2.9 0 0 1 5.8 0Z M14.3 5.8h.01',
	facebook: 'M12.6 3.4h-1.7a3 3 0 0 0-3 3V9H6.2v2.6h1.7v5h2.6v-5h2l.4-2.6h-2.4V6.9c0-.5.3-.8.8-.8h1.3V3.4Z',
};
---

<svg
	class={className}
	width="20"
	height="20"
	viewBox="0 0 20 20"
	fill="none"
	stroke="currentColor"
	stroke-width="1.35"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"><path d={paths[name]}></path></svg
>
