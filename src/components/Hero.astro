---
import { getImage } from 'astro:assets';
import { photos, heroAlt } from '../data/images';
import womenOwnedWordmark from '../assets/women-owned-wordmark.webp';
import Icon from './Icon.astro';

/**
 * Two art-directed photos: a wide one that leaves the left third open for the
 * headline, and a separate portrait photo for phones. Eager + high priority - this is the
 * largest contentful paint and must never be lazy-loaded.
 *
 * The bottom of the hero is left clear: the quote card that follows is pulled
 * up over it (see QuoteSection).
 */
const desktop = await getImage({
	src: photos.heroDesktop,
	widths: [1200, 1600, 2000, 2400],
	format: 'webp',
});
// The mobile photo is a separate, portrait image (832px wide); never upscale it.
const mobile = await getImage({ src: photos.heroMobile, widths: [600, 832], format: 'webp' });
---

<section class="hero">
	<picture class="hero__picture">
		<source media="(max-width: 768px)" srcset={mobile.srcSet.attribute} sizes="100vw" />
		<img
			class="hero__image"
			src={desktop.src}
			srcset={desktop.srcSet.attribute}
			sizes="100vw"
			width={desktop.attributes.width ?? 2400}
			height={desktop.attributes.height ?? 1100}
			alt={heroAlt}
			loading="eager"
			decoding="async"
			fetchpriority="high"
		/>
	</picture>
	<div class="hero__overlay"></div>
	<div class="hero__content">
		<p class="hero__eyebrow">
			<span class="hero__rule" aria-hidden="true"></span>
			Transportation in Lake Geneva, Wisconsin
		</p>
		<h1 class="hero__title">
			<span class="hero__line">Lake Geneva Trolley Rental</span>
			<span class="hero__line"><em class="hero__for">for</em> <em class="grad">Weddings, Events</em> &amp;</span>
			<span class="hero__line">Group Transportation</span>
		</h1>
		<p class="hero__tagline">Private Trolleys. Professional Chauffeurs.</p>
		<p class="hero__lead">Trolley rental in Lake Geneva, WI for your group.</p>
		<span class="hero__divider" aria-hidden="true"><span></span></span>
		<div class="hero__ownership">
			<span class="hero__proudly">Proudly</span>
			<span class="hero__logoCrop">
				<img
					src={womenOwnedWordmark.src}
					width={womenOwnedWordmark.width}
					height={womenOwnedWordmark.height}
					alt="WBENC-certified Women Owned business"
					class="hero__ownershipLogo"
					loading="eager"
					decoding="async"
				/>
			</span>
		</div>
		<div class="hero__actions">
			<a class="btn-red" href="#getquote">Get a Free Quote <Icon name="arrow-long" /></a>
			<a class="btn-line" href="/fleet/">View Our Fleet</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 660px;
		overflow: hidden;
		background: var(--brand-green-deep);
	}

	.hero__picture,
	.hero__image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__image {
		object-fit: cover;
		/* The photo is 2:1 and the hero box is wider, so height is what gets cropped.
		   Favour the top: the quote card covers the bottom of the frame. */
		object-position: 50% 40%;
	}

	/* Shade the text column and the strip the quote card sits on; leave the vehicles clear.
	   The radial sits behind the headline, whose first line reaches into the bright sky. */
	.hero__overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgb(11 47 32 / 0) 62%, rgb(11 47 32 / 0.55) 100%),
			radial-gradient(ellipse 46% 44% at 30% 30%, rgb(6 22 15 / 0.5) 0%, rgb(6 22 15 / 0.32) 60%, rgb(6 22 15 / 0) 100%),
			linear-gradient(
				90deg,
				rgb(6 22 15 / 0.86) 0%,
				rgb(6 22 15 / 0.72) 30%,
				rgb(6 22 15 / 0.46) 50%,
				rgb(6 22 15 / 0.14) 64%,
				rgb(6 22 15 / 0) 76%
			);
		pointer-events: none;
	}

	.hero__content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		width: 100%;
		max-width: 1240px;
		margin: 0 auto;
		padding: 64px 28px 150px;
	}

	.hero__eyebrow {
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 0 0 20px;
		color: var(--gold-light);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
	}

	.hero__rule {
		flex: none;
		width: 40px;
		height: 1px;
		background: var(--gold);
	}

	.hero__title {
		margin: 0;
		color: #fff;
		font-family: var(--serif);
		font-size: clamp(40px, 4.6vw, 64px);
		font-weight: 400;
		line-height: 1.06;
		text-shadow: 0 2px 26px rgb(0 0 0 / 0.38);
	}

	.hero__line {
		display: block;
	}

	@media (width > 768px) {
		.hero__line {
			white-space: nowrap;
		}
	}

	.hero__for {
		font-style: italic;
	}

	.hero__tagline {
		margin: 24px 0 0;
		color: #fff;
		font-size: clamp(16px, 1.5vw, 19px);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.42);
	}

	.hero__lead {
		margin: 4px 0 0;
		color: rgb(255 255 255 / 0.9);
		font-size: clamp(15px, 1.4vw, 17px);
		font-weight: 300;
		line-height: 1.6;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.42);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.hero__actions a:focus-visible {
		outline: 2px solid var(--gold-light);
		outline-offset: 4px;
	}

	/* After the reference: a short gold rule, then the credential. */
	.hero__divider {
		display: flex;
		align-items: center;
		gap: 11px;
		margin: 24px 0 20px;
	}

	.hero__divider span {
		width: 90px;
		height: 1px;
		background: var(--gold);
	}

	.hero__ownership {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 7px;
	}

	.hero__proudly {
		color: var(--gold);
		font-size: 11.5px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.48);
	}

	.hero__logoCrop {
		position: relative;
		display: block;
		width: clamp(120px, 11vw, 150px);
		aspect-ratio: 515 / 216;
		overflow: hidden;
	}

	.hero__ownershipLogo {
		position: absolute;
		top: -32%;
		left: -3%;
		display: block;
		width: 106%;
		max-width: none;
		height: auto;
		filter: invert(1) hue-rotate(180deg) saturate(1.08) brightness(1.08);
	}

	/* The text column is wider relative to the photo here, so the fade runs further. */
	@media (769px <= width <= 1023px) {
		.hero__overlay {
			background:
				linear-gradient(180deg, rgb(11 47 32 / 0) 62%, rgb(11 47 32 / 0.55) 100%),
				linear-gradient(
					90deg,
					rgb(6 22 15 / 0.88) 0%,
					rgb(6 22 15 / 0.74) 40%,
					rgb(6 22 15 / 0.36) 66%,
					rgb(6 22 15 / 0) 90%
				);
		}
	}

	@media (width <= 768px) {
		.hero {
			min-height: 0;
		}

		.hero__image {
			object-position: 50% 8%;
		}

		/* Shade the left, where the text starts, and ease off towards the right edge.
		   A band across the top keeps the full-width headline legible over the sky. */
		.hero__overlay {
			background:
				linear-gradient(180deg, rgb(11 47 32 / 0) 70%, rgb(11 47 32 / 0.6) 100%),
				linear-gradient(180deg, rgb(6 22 15 / 0.42) 0%, rgb(6 22 15 / 0.36) 46%, rgb(6 22 15 / 0) 60%),
				linear-gradient(
					90deg,
					rgb(6 22 15 / 0.78) 0%,
					rgb(6 22 15 / 0.52) 45%,
					rgb(6 22 15 / 0.2) 78%,
					rgb(6 22 15 / 0.06) 100%
				);
		}

		.hero__content {
			padding: 52px 20px 96px;
		}

		.hero__eyebrow {
			margin-bottom: 16px;
			font-size: 9.5px;
			letter-spacing: 0.2em;
		}

		.hero__rule {
			display: none;
		}

		.hero__title {
			font-size: clamp(2.2rem, 9vw, 3.1rem);
			line-height: 1.02;
			text-wrap: balance;
			text-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
		}

		/* Gradient text is transparent, so a text-shadow would show through the letters. */
		.hero__title .grad {
			text-shadow: none;
			filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.35));
		}

		.hero__tagline {
			margin-top: 18px;
		}

		.hero__actions {
			flex-direction: column;
			align-self: stretch;
			gap: 10px;
			margin-top: 24px;
		}

		.hero__divider {
			margin: 20px 0 16px;
		}

		.hero__logoCrop {
			width: 120px;
		}

		.hero__ownership {
			padding-bottom: 20px;
		}
	}
</style>
