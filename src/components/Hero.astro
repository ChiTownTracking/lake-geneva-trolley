---
import { getImage } from 'astro:assets';
import { photos, heroAlt } from '../data/images';
import womenOwnedWordmark from '../assets/women-owned-wordmark.webp';

/**
 * Two art-directed photos: a wide one that leaves the left third open for the
 * headline, and a separate portrait photo for phones. Eager + high priority - this is the
 * largest contentful paint and must never be lazy-loaded.
 */
const desktop = await getImage({
	src: photos.heroDesktop,
	widths: [1200, 1600, 2000, 2400],
	format: 'webp',
});
// The mobile photo is a separate, portrait image (832px wide); never upscale it.
const mobile = await getImage({ src: photos.heroMobile, widths: [600, 832], format: 'webp' });
---

<section class="hero">
	<picture class="hero__picture">
		<source media="(max-width: 768px)" srcset={mobile.srcSet.attribute} sizes="100vw" />
		<img
			class="hero__image"
			src={desktop.src}
			srcset={desktop.srcSet.attribute}
			sizes="100vw"
			width={desktop.attributes.width ?? 2400}
			height={desktop.attributes.height ?? 1100}
			alt={heroAlt}
			loading="eager"
			decoding="async"
			fetchpriority="high"
		/>
	</picture>
	<div class="hero__overlay"></div>
	<div class="hero__content">
		<h1 class="hero__title">
			<span class="hero__titleLine">Lake Geneva Trolley &amp; Bus Rental</span>
			<span class="hero__finalLine">
				<em class="hero__for">for</em>{' '}
				<em class="grad">Weddings &amp; Events</em>
			</span>
		</h1>
		<p class="hero__lead">
			Private trolley and bus charters around Geneva Lake.
		</p>
		<span class="hero__divider" aria-hidden="true"><span></span><i></i></span>
		<div class="hero__ownership">
			<span class="hero__proudly">Proudly</span>
			<span class="hero__logoCrop">
				<img
					src={womenOwnedWordmark.src}
					width={womenOwnedWordmark.width}
					height={womenOwnedWordmark.height}
					alt="WBENC-certified Women Owned business"
					class="hero__ownershipLogo"
					loading="eager"
					decoding="async"
				/>
			</span>
		</div>
		<a class="btn-gold hero__cta" href="/fleet/">View Fleet</a>
	</div>
</section>

<style>
	.hero {
		position: relative;
		height: 550px;
		overflow: hidden;
		background: #14242e;
	}

	.hero__picture,
	.hero__image {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__image {
		object-fit: cover;
		/* The photo is 2:1 and the hero box is wider, so height is what gets cropped.
		   Just above centre keeps the sunset and the vehicles and drops the least
		   interesting foreground paving. */
		object-position: 50% 52%;
	}

	/* Shade the text column, then fade completely to the untouched photograph. */
	.hero__overlay {
		position: absolute;
		inset: 0;
		opacity: 0.8;
		background: linear-gradient(
			90deg,
			rgb(0 0 0 / 0.9) 0%,
			rgb(0 0 0 / 0.76) 26%,
			rgb(0 0 0 / 0.4) 44%,
			rgb(0 0 0 / 0) 65%
		);
		pointer-events: none;
	}

	.hero__content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		max-width: 1400px;
		margin-top: 76px;
		padding: 0 clamp(24px, 6vw, 96px);
		text-align: left;
	}

	.hero__title {
		margin: 0;
		color: #fff;
		font-family: var(--serif);
		font-size: clamp(34px, 5vw, 60px);
		font-weight: 400;
		line-height: 1.08;
		text-shadow: 0 2px 26px rgb(0 0 0 / 0.38);
	}

	.hero__titleLine,
	.hero__finalLine {
		display: block;
	}

	.hero__for {
		font-style: italic;
	}

	.hero__lead {
		max-width: 52ch;
		margin: 18px 0 0;
		color: rgb(255 255 255 / 0.9);
		font-size: clamp(14px, 1.5vw, 17px);
		font-weight: 300;
		line-height: 1.65;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.42);
	}

	.hero__divider {
		display: flex;
		align-items: center;
		gap: 11px;
		margin: 22px 0;
	}

	.hero__divider span {
		width: 90px;
		height: 1px;
		background: var(--gold);
	}

	.hero__divider i {
		width: 7px;
		height: 7px;
		background: var(--gold);
		transform: rotate(45deg);
	}

	.hero__ownership {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 7px;
	}

	.hero__proudly {
		color: var(--gold);
		font-size: 13px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.48);
	}

	.hero__logoCrop {
		position: relative;
		display: block;
		width: clamp(120px, 13vw, 155px);
		aspect-ratio: 515 / 216;
		overflow: hidden;
	}

	.hero__ownershipLogo {
		position: absolute;
		top: -32%;
		left: -3%;
		display: block;
		width: 106%;
		max-width: none;
		height: auto;
		filter: invert(1) hue-rotate(180deg) saturate(1.08) brightness(1.08);
	}

	.hero__cta {
		display: inline-flex;
		align-self: flex-start;
		align-items: center;
		min-height: 40px;
		margin-top: 26px;
		padding: 11px 28px;
		font-size: 11.5px;
		letter-spacing: 0.2em;
	}

	.hero__cta:focus-visible {
		outline: 2px solid var(--gold-light);
		outline-offset: 4px;
	}

	/* Extend the fade with the wider relative text column on smaller screens. */
	@media (769px <= width <= 1023px) {
		.hero__overlay {
			background: linear-gradient(
				90deg,
				rgb(0 0 0 / 0.9) 0%,
				rgb(0 0 0 / 0.78) 34%,
				rgb(0 0 0 / 0.42) 58%,
				rgb(0 0 0 / 0) 85%
			);
		}

		.hero__content {
			width: min(92%, 620px);
		}
	}

	@media (width <= 768px) {
		.hero {
			height: auto;
			min-height: clamp(400px, 60svh, 470px);
		}

		.hero__image {
			object-position: 66% center;
		}

		/* The reference's soft paper curve where the hero meets the page. It is cut
		   out of the hero with a mask rather than painted over it, so no clipped
		   overlay edge is left to show as a grey seam at fractional zoom levels. */
		.hero {
			-webkit-mask-image: radial-gradient(60% 44px at 50% calc(100% + 22px), transparent 97%, #000 100%);
			mask-image: radial-gradient(60% 44px at 50% calc(100% + 22px), transparent 97%, #000 100%);
		}

		/* Shade the left, where the text starts, and leave the right of the photo clear. */
		.hero__overlay {
			opacity: 1;
			background: linear-gradient(
				90deg,
				rgb(0 0 0 / 0.72) 0%,
				rgb(0 0 0 / 0.5) 38%,
				rgb(0 0 0 / 0.18) 72%,
				rgb(0 0 0 / 0) 100%
			);
		}

		.hero__content {
			width: 100%;
			margin: 0;
			padding: 50px 22px 58px;
		}

		.hero__title {
			width: 100%;
			font-size: clamp(2.15rem, 8.5vw, 3.25rem);
			line-height: 1;
			text-wrap: balance;
			/* A very light shadow: just enough to lift the text off the bright sky. */
			text-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
		}

		/* Gradient text is transparent, so a text-shadow would show through the letters. */
		.hero__title .grad {
			text-shadow: none;
			filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.35));
		}

		.hero__lead {
			max-width: none;
			margin-top: 14px;
			font-size: 14.5px;
			line-height: 1.55;
			text-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
		}

		.hero__divider {
			margin: 18px 0;
		}

		.hero__ownership {
			gap: 6px;
		}

		.hero__logoCrop {
			width: clamp(110px, 35vw, 130px);
		}

		.hero__cta {
			min-height: 40px;
			margin-top: 20px;
			letter-spacing: 0.18em;
		}
	}

	/* On narrow phones the portrait photo only just overfills the box; show the
	   top of the frame so the trolley sits lower, below the intro text. */
	@media (width <= 480px) {
		.hero__image {
			object-position: 50% 8%;
		}
	}

	@media (width <= 360px) {
		.hero__content {
			width: 100%;
		}
		.hero__title {
			width: 100%;
			font-size: 2.05rem;
		}
		.hero__divider span {
			width: 76px;
		}
	}
</style>
