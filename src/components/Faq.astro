---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { faqs } from '../data/content';
import SectionHeading from './SectionHeading.astro';

interface Props {
	eyebrow?: string;
	title?: string;
	/** Limit how many questions appear (the homepage shows a subset). */
	limit?: number;
	background?: 'cream' | 'paper';
	/** Page-specific questions; defaults to the site-wide list. */
	items?: { q: string; a: string }[];
	/**
	 * A photograph beside the questions. Switches to a left-aligned, two-column
	 * layout with boxed questions.
	 */
	media?: { src: ImageMetadata; alt: string };
	/** Questions as separate rounded boxes with plus icons. Implied by `media`. */
	boxed?: boolean;
	tone?: 'gold' | 'red';
}

const {
	eyebrow = 'Common Questions',
	title = 'Questions before you book',
	limit,
	background = 'cream',
	items: source = faqs,
	media,
	boxed = Boolean(media),
	tone = 'gold',
} = Astro.props;

const items = limit ? source.slice(0, limit) : source;
---

<section class:list={['rv', 'faq', `faq--${background}`, { 'faq--boxed': boxed, 'faq--split': media }]}>
	<div class:list={['wrap', { 'wrap-wide faq__split': media }]}>
		<div class="faq__main">
			<SectionHeading eyebrow={eyebrow} title={title} align={media ? 'left' : 'center'} tone={tone} />

			<div class="faq__list" data-faq>
				{
					items.map((item, index) => (
						<div class="faq__item">
							<h3 class="faq__heading">
								<button
									type="button"
									class="faq__head"
									aria-expanded="false"
									aria-controls={`faq-panel-${index}`}
									id={`faq-head-${index}`}
									data-faq-toggle
								>
									<span class="faq__q">{item.q}</span>
									<span class="faq__chev" aria-hidden="true" />
								</button>
							</h3>
							<div class="faq__panel">
								<div class="faq__body" id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-head-${index}`}>
									<p class="faq__a">{item.a}</p>
								</div>
							</div>
						</div>
					))
				}
			</div>

			{
				(boxed || (limit && limit < source.length)) && (
					<p class="faq__more">
						<a class="link-gold" href="/faq/">
							See all questions &rarr;
						</a>
					</p>
				)
			}
		</div>

		{
			media && (
				<div class="faq__media">
					<Image
						class="faq__img"
						src={media.src}
						alt={media.alt}
						widths={[500, 800, 1100]}
						sizes="(max-width: 960px) 100vw, 44vw"
						loading="lazy"
					/>
				</div>
			)
		}
	</div>
</section>

<style>
	.faq {
		padding: 56px 28px;
	}

	.faq--cream {
		background: var(--cream);
	}

	.faq--paper {
		background: var(--paper);
	}

	.faq__list {
		max-width: 800px;
		margin: 0 auto;
	}

	.faq__item {
		border-top: 1px solid var(--line-2);
	}

	.faq__item:last-child {
		border-bottom: 1px solid var(--line-2);
	}

	.faq__heading {
		margin: 0;
		font-weight: inherit;
	}

	.faq__head {
		display: flex;
		align-items: center;
		gap: 20px;
		width: 100%;
		padding: 24px 4px;
		border: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--serif);
		text-align: left;
		cursor: pointer;
	}

	.faq__q {
		flex: 1;
		font-size: 20px;
		font-weight: 600;
		line-height: 1.35;
	}

	.faq__chev {
		flex: none;
		width: 10px;
		height: 10px;
		border-right: 1.5px solid var(--gold-deep);
		border-bottom: 1.5px solid var(--gold-deep);
		transform: translateY(-2px) rotate(45deg);
		transition: transform 0.3s;
	}

	.faq__item.is-open .faq__chev {
		transform: translateY(2px) rotate(-135deg);
	}

	.faq__panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.35s;
	}

	.faq__item.is-open .faq__panel {
		grid-template-rows: 1fr;
	}

	.faq__body {
		min-height: 0;
		overflow: hidden;
	}

	.faq__a {
		max-width: 66ch;
		margin: 0;
		padding: 0 4px 26px;
		color: var(--muted);
		font-size: 15px;
		font-weight: 300;
		line-height: 1.8;
	}

	.faq__more {
		margin: 34px 0 0;
		text-align: center;
	}

	/* ---- Boxed questions, optionally beside a photograph ------------------ */

	.faq--boxed {
		padding: 84px 0;
	}

	.faq--boxed:not(.faq--split) .faq__list {
		max-width: 860px;
		margin-inline: auto;
	}

	.faq--boxed:not(.faq--split) .faq__more {
		text-align: center;
	}

	.faq__split {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		align-items: stretch;
		gap: clamp(40px, 5vw, 80px);
	}

	.faq--boxed .faq__main :global(.sh) {
		margin-bottom: 30px;
	}

	.faq--boxed .faq__list {
		display: grid;
		gap: 10px;
		max-width: none;
		margin: 0;
	}

	.faq--boxed .faq__item,
	.faq--boxed .faq__item:last-child {
		border: 1px solid var(--line-2);
		border-radius: 6px;
		background: #fff;
		transition:
			border-color 0.25s,
			box-shadow 0.25s;
	}

	.faq--boxed .faq__item.is-open {
		border-color: var(--gold-cream);
		box-shadow: 0 10px 28px rgb(26 26 26 / 0.06);
	}

	.faq--boxed .faq__head {
		padding: 18px 22px;
	}

	.faq--boxed .faq__q {
		font-size: 19px;
	}

	.faq--boxed .faq__a {
		padding: 0 22px 22px;
		font-size: 14.5px;
		line-height: 1.75;
	}

	/* Plus that turns into a minus. */
	.faq--boxed .faq__chev {
		position: relative;
		width: 14px;
		height: 14px;
		border: 0;
		transform: none;
	}

	.faq--boxed .faq__chev::before,
	.faq--boxed .faq__chev::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 1.5px;
		background: var(--brand-red);
		transform: translateY(-50%);
		transition: transform 0.3s;
	}

	.faq--boxed .faq__chev::after {
		transform: translateY(-50%) rotate(90deg);
	}

	.faq--boxed .faq__item.is-open .faq__chev {
		transform: none;
	}

	.faq--boxed .faq__item.is-open .faq__chev::after {
		transform: translateY(-50%) rotate(0deg);
	}

	.faq--boxed .faq__more {
		text-align: left;
	}

	.faq__media {
		position: relative;
		min-height: 420px;
		overflow: hidden;
		border-radius: 6px;
	}

	.faq__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (width <= 960px) {
		.faq__split {
			grid-template-columns: 1fr;
		}
		.faq__media {
			order: -1;
			min-height: 260px;
		}
	}

	@media (width <= 560px) {
		.faq {
			padding: 44px 20px;
		}
		.faq--boxed {
			padding: 56px 0;
		}
		.faq__q,
		.faq--boxed .faq__q {
			font-size: 17px;
		}
		.faq__head {
			gap: 14px;
			padding: 20px 2px;
		}
		.faq--boxed .faq__head {
			padding: 16px 16px;
		}
		.faq--boxed .faq__a {
			padding: 0 16px 18px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq__panel,
		.faq__chev,
		.faq__chev::before,
		.faq__chev::after {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-faq]').forEach((list) => {
		const items = Array.from(list.querySelectorAll<HTMLElement>('.faq__item'));

		const setOpen = (item: HTMLElement, open: boolean) => {
			item.classList.toggle('is-open', open);
			item.querySelector('[data-faq-toggle]')?.setAttribute('aria-expanded', String(open));
			const body = item.querySelector<HTMLElement>('.faq__body');
			if (body) body.inert = !open;
		};

		items.forEach((item) => {
			setOpen(item, false);
			item.querySelector('[data-faq-toggle]')?.addEventListener('click', () => {
				const wasOpen = item.classList.contains('is-open');
				items.forEach((other) => setOpen(other, false));
				if (!wasOpen) setOpen(item, true);
			});
		});
	});
</script>
