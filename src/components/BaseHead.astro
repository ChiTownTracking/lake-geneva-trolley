---
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { photos, alt } from '../data/images';
import { getHomeHeroImages } from '../data/hero-images';
import sansFont from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import headingFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import italicFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-italic.woff2?url';

interface Props {
	title: string;
	description: string;
	/** Path only, e.g. '/fleet'. Defaults to the current page. */
	canonical?: string;
	/** Adds a JSON-LD block. Only verified facts are ever emitted. */
	structuredData?: Record<string, unknown> | null;
}

const { title, description, canonical, structuredData = null } = Astro.props;

// Normalised to the trailing-slash form so canonicals, internal links and the
// generated sitemap all agree.
const path = (canonical ?? Astro.url.pathname).replace(/\/*$/, '/');
const canonicalUrl = new URL(path, site.url).href;

// The classic trolley is the image search engines and social cards should show
// for the brand. Kept at its own aspect ratio so the whole vehicle stays in frame.
const ogImage = await getImage({ src: photos.fleetClassicTrolley, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, site.url).href;
const ogImageHeight = Math.round((1200 * photos.fleetClassicTrolley.height) / photos.fleetClassicTrolley.width);
const schema = structuredData?.['@type'] === 'Organization' ? { ...structuredData, image: ogImageUrl } : structuredData;
const heroImages = path === '/' ? await getHomeHeroImages() : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />

{
	heroImages && (
		<>
			<link rel="preload" as="image" type="image/avif" media="(max-width: 768px)" imagesrcset={heroImages[2].srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
			<link rel="preload" as="image" type="image/avif" media="(min-width: 769px)" imagesrcset={heroImages[0].srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
			<link rel="preload" as="font" type="font/woff2" href={sansFont} crossorigin="anonymous" />
			<link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin="anonymous" />
			<link rel="preload" as="font" type="font/woff2" href={italicFont} crossorigin="anonymous" />
		</>
	)
}

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#01432a" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={alt.fleetClassicTrolley} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{
	schema && (
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(schema)}
		/>
	)
}
