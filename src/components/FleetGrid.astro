---
import { Image } from 'astro:assets';
import { fleet, type Vehicle } from '../data/content';

interface Props {
	/** Link target for each card. Defaults to the fleet page anchor. */
	hrefFor?: (id: string) => string;
	/** Vehicle ids to show, in order. Defaults to the whole fleet. */
	ids?: string[];
	/** Page-specific card copy and destinations, without renaming fleet entries. */
	cardOverrides?: Record<string, Partial<Pick<Vehicle, 'name' | 'caption' | 'description' | 'capacityLabel' | 'image' | 'imageAlt' | 'interior'>> & {
		href?: string;
		linkLabel?: string;
	}>;
}

const { hrefFor = (id: string) => `/fleet#${id}`, ids, cardOverrides = {} } = Astro.props;

const shown = ids
	? ids.map((id) => fleet.find((v) => v.id === id)).filter((v) => v !== undefined)
	: fleet;
const cards = shown.map((vehicle) => ({ ...vehicle, ...cardOverrides[vehicle.id] }));
---

<div class="fleetp__grid">
	{
		cards.map((vehicle) => (
			<a class="fleet-card" href={vehicle.href ?? hrefFor(vehicle.id)}>
				<div class="fleet-card__media">
					<Image
						class="fleetp__img"
						src={vehicle.image}
						alt={vehicle.imageAlt}
						widths={[500, 800, 1000]}
						sizes="(max-width: 480px) 100vw, (max-width: 1080px) 46vw, 500px"
						loading="lazy"
					/>
					{vehicle.interior && (
						<Image
							class="fleetp__img fleetp__img--interior"
							src={vehicle.interior.image}
							alt=""
							widths={[500, 800, 1000]}
							sizes="(max-width: 480px) 100vw, (max-width: 1080px) 46vw, 500px"
							loading="lazy"
						/>
					)}
					{vehicle.interior && <span class="fleetp__peek">Interior</span>}
				</div>
				<div class="fleetp__body">
					<p class="fleetp__cap">{vehicle.caption}</p>
					<h3 class="fleetp__name">{vehicle.name}</h3>
					<p class="fleetp__capacity">{vehicle.capacityLabel}</p>
					{vehicle.status !== 'available' && <p class="fleetp__status">{vehicle.status === 'seasonal' ? 'Seasonal' : 'Coming Soon'}</p>}
					<p class="fleetp__description">{vehicle.description}</p>
						<span class="link-gold fleetp__more">{vehicle.linkLabel ?? 'View Vehicle'} &rarr;</span>
				</div>
			</a>
		))
	}
</div>

<style>
	.fleetp__grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 32px;
		max-width: 1180px;
		margin: 0 auto;
	}

	.fleet-card {
		display: block;
		flex: 1 1 400px;
		width: 100%;
		min-width: 320px;
		max-width: 500px;
		overflow: hidden;
		border: 1px solid var(--line-2);
		background: var(--paper);
		box-shadow: 0 2px 10px rgb(26 26 26 / 0.04);
		color: inherit;
		text-decoration: none;
		transition: box-shadow 0.35s, transform 0.35s, border-color 0.35s;
	}

	.fleet-card:hover {
		border-color: var(--gold-cream);
		box-shadow: 0 18px 44px rgb(26 26 26 / 0.14);
		transform: translateY(-4px);
	}

	.fleet-card__media {
		position: relative;
		overflow: hidden;
	}

	.fleetp__img {
		display: block;
		width: 100%;
		height: 330px;
		object-fit: cover;
		transition:
			transform 0.6s cubic-bezier(0.22, 0.6, 0.2, 1),
			opacity 0.45s ease;
	}

	.fleet-card:hover .fleetp__img {
		transform: scale(1.05);
	}

	/*
	 * Interior reveal. The exterior sells the vehicle from the kerb, but the
	 * seating layout is what the copy actually describes - so the interior
	 * cross-fades over it. Gated behind (hover: hover): a touch screen has no
	 * hover to leave, so the swap would stick after the first tap.
	 */
	.fleetp__img--interior {
		position: absolute;
		inset: 0;
		opacity: 0;
	}

	.fleetp__peek {
		position: absolute;
		right: 14px;
		bottom: 14px;
		padding: 6px 13px;
		border: 1px solid rgb(255 255 255 / 0.45);
		background: rgb(0 0 0 / 0.55);
		color: var(--gold-light);
		font-size: 10px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.35s,
			transform 0.35s;
	}

	@media (hover: hover) {
		.fleet-card:hover .fleetp__img--interior,
		.fleet-card:focus-visible .fleetp__img--interior {
			opacity: 1;
		}

		.fleet-card:hover .fleetp__peek,
		.fleet-card:focus-visible .fleetp__peek {
			opacity: 1;
			transform: none;
		}
	}

	.fleetp__body {
		padding: 26px 30px 30px;
		text-align: center;
	}

	.fleetp__cap {
		margin: 0 0 8px;
		color: var(--gold-deep);
		font-size: 11px;
		letter-spacing: 0.24em;
		text-transform: uppercase;
	}

	.fleetp__name {
		position: relative;
		display: inline-block;
		margin: 0;
		padding-bottom: 7px;
		font-family: var(--serif);
		font-size: 25px;
		font-weight: 600;
	}

	.fleetp__name::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 0;
		height: 2px;
		background: var(--grad-gold);
		transform: translateX(-50%);
		transition: width 0.35s;
	}

	.fleet-card:hover .fleetp__name::after,
	.fleet-card:focus-visible .fleetp__name::after {
		width: 44px;
	}

	.fleetp__capacity {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 12px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.fleetp__description {
		max-width: 34ch;
		margin: 15px auto 0;
		color: var(--muted);
		font-size: 14.5px;
		font-weight: 300;
		line-height: 1.65;
	}

	.fleetp__status { margin: 12px 0 0; color: var(--gold-deep); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }

	.fleetp__more {
		margin-top: 22px;
	}

	@media (hover: none) {
		.fleetp__name::after {
			width: 44px;
		}
	}

	@media (width <= 640px) {
		.fleetp__grid {
			gap: 24px;
		}
		.fleet-card {
			overflow: hidden;
			border-radius: 5px;
		}
		.fleetp__img {
			height: 250px;
		}
		.fleetp__body {
			padding: 24px 24px 28px;
		}
	}

	@media (width <= 480px) {
		.fleet-card {
			flex-basis: 100%;
			min-width: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fleet-card,
		.fleetp__img,
		.fleetp__peek {
			transition: none;
		}
	}
</style>
