---
import { contact, socials, site, hasContact } from '../data/site';
import Icon from './Icon.astro';

const topbarSocials = socials.toSorted((a, b) => a.icon.localeCompare(b.icon));
---

<div class="topbar">
	<div class="topbar__inner wrap wrap-wide">
		<div class="topbar__contact">
			{
				contact.phoneHref && contact.phoneLabel && (
					<a class="topbar__link" href={`tel:${contact.phoneHref}`}>
						<svg class="topbar__icon topbar__icon--phone" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
						</svg>
						{contact.phoneLabel}
					</a>
				)
			}
			{contact.phoneLabel && contact.email && <span class="topbar__divider" />}
			{
				contact.email && (
					<a class="topbar__link topbar__link--email" href={`mailto:${contact.email}`}>
						<svg class="topbar__icon topbar__icon--mail" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<rect x="2" y="4" width="20" height="16" rx="2" />
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
						</svg>
						{contact.email}
					</a>
				)
			}
			{!hasContact && <p class="topbar__note">{site.tagline}</p>}
		</div>

		{
			topbarSocials.length > 0 ? (
				<nav class="topbar__social" aria-label="Social profiles">
					{topbarSocials.map((s) => (
						<a
							class="topbar__socialLink"
							href={s.href}
							target={s.href.startsWith('http') ? '_blank' : undefined}
							rel="noopener noreferrer"
							aria-label={`Visit ${site.name} on ${s.name}`}
							title={s.name}
						>
							{s.icon === 'facebook' ? (
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
									<path d="M13.7 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5H17V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.5V13h2.8v8h3.4Z" />
								</svg>
							) : (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
									<rect x="3" y="3" width="18" height="18" rx="5" />
									<circle cx="12" cy="12" r="4" />
									<circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none" />
								</svg>
							)}
						</a>
					))}
				</nav>
			) : (
				<a class="topbar__link topbar__link--cta" href="/#getquote">
					<Icon name="chat" class="topbar__icon" />
					Request a quote
				</a>
			)
		}
	</div>
</div>

<style>
	.topbar {
		background: var(--ink);
	}

	.topbar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		height: 40px;
	}

	.topbar__contact {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 28px;
		min-width: 0;
		overflow: hidden;
	}

	.topbar__link {
		display: flex;
		flex: none;
		align-items: center;
		gap: 9px;
		color: var(--gold-cream);
		font-size: 12.5px;
		font-weight: 300;
		letter-spacing: 0.06em;
		white-space: nowrap;
		text-decoration: none;
		transition: color 0.25s;
	}

	.topbar__link:hover {
		color: var(--gold-light);
	}

	.topbar__link:focus-visible {
		outline: 2px solid var(--gold-light);
		outline-offset: 2px;
	}

	.topbar__link--email {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.topbar__link--cta {
		margin-left: auto;
	}

	.topbar__icon {
		flex: none;
		width: 16px;
		height: 16px;
		color: var(--gold);
	}

	.topbar__icon--phone {
		width: 13px;
		height: 13px;
	}

	.topbar__icon--mail {
		width: 14px;
		height: 14px;
	}

	.topbar__note {
		margin: 0;
		color: #e5dcc7;
		font-size: 12.5px;
		font-weight: 300;
		letter-spacing: 0.06em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.topbar__divider {
		width: 1px;
		height: 14px;
		background: rgb(212 175 106 / 0.35);
	}

	.topbar__social {
		display: flex;
		flex: none;
		align-items: center;
		gap: 16px;
		margin-left: auto;
	}

	.topbar__socialLink {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		color: var(--gold);
		text-decoration: none;
		transition: color 0.2s, opacity 0.2s, transform 0.2s;
	}

	.topbar__socialLink svg {
		display: block;
		width: 17px;
		height: 17px;
	}

	.topbar__socialLink:hover {
		color: var(--gold-light);
		transform: translateY(-1px);
	}

	.topbar__socialLink:focus-visible {
		outline: 2px solid var(--gold-light);
		outline-offset: 2px;
		border-radius: 2px;
	}

	@media (width <= 768px) {
		.topbar__inner {
			gap: 12px;
			padding-inline: 10px;
		}
		.topbar__link--email,
		.topbar__divider {
			display: none;
		}
		.topbar__social {
			margin-right: 0;
		}
		.topbar__socialLink {
			width: 44px;
			height: 40px;
		}
		.topbar__socialLink svg {
			width: 18px;
			height: 18px;
		}
		.topbar__contact {
			margin-left: 0;
			margin-right: auto;
		}
		.topbar__link--cta .topbar__icon {
			width: 15px;
			height: 15px;
		}
		.topbar__note {
			font-size: 12px;
		}
	}

	@media (width <= 480px) {
		.topbar__inner,
		.topbar__socialLink {
			height: 44px;
		}
	}

	@media (width <= 420px) {
		.topbar__note {
			letter-spacing: 0.02em;
		}
		.topbar__link--cta {
			font-size: 12px;
		}
	}
</style>
