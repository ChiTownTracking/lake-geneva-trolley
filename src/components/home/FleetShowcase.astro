---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../SectionHeading.astro';
import { photos, alt } from '../../data/images';
import { fleetGalleries } from '../../data/fleet-images';

interface Card {
	name: string;
	/** The seating or size range, set above the name. */
	caption: string;
	capacity: string;
	body: string;
	href: string;
	link: string;
	image: ImageMetadata;
	imageAlt: string;
	/** Cross-faded in on hover, for pointer devices only. */
	alternate: ImageMetadata;
}

// Largest capacity in each category (fleet.ts): Sprinter vans seat up to 15.
// Party bus range and unit count supplied by the owner, October 4, 2026.
const cards: Card[] = [
	{
		name: 'Trolleys',
		caption: 'Classic & Limo Seating',
		capacity: 'Up to 36',
		body: 'Choose classic or limo trolley rental in Lake Geneva for wedding parties, special events and private group outings.',
		href: '/fleet/#trolley',
		link: 'Explore Trolley Rentals',
		image: photos.fleetClassicTrolley,
		imageAlt: alt.fleetClassicTrolley,
		alternate: fleetGalleries['limo-trolley'][3].image,
	},
	{
		name: 'Coach Buses',
		caption: 'Small, Mid-Size & Super Coach',
		capacity: 'Up to 57',
		body: 'Lake Geneva charter bus rental for wedding guest shuttles, corporate groups and longer trips, with three coach sizes.',
		href: '/fleet/#coach-bus',
		link: 'Explore Coach Rentals',
		image: photos.fleetCoachBus,
		imageAlt: alt.fleetCoachBus,
		alternate: photos.fleetCoachBusInterior,
	},
	{
		name: 'Party Bus',
		caption: 'Lounge Seating & Party Lighting',
		capacity: '20–45',
		body: 'Explore 10 party buses with different sizes and interiors for Lake Geneva birthdays, bachelor and bachelorette parties, and group celebrations.',
		href: '/fleet/#party-bus',
		link: 'Explore Party Bus Rentals',
		image: photos.fleetPartyBus,
		imageAlt: alt.fleetPartyBus,
		alternate: photos.fleetPartyBusInterior,
	},
	{
		name: 'Sprinter Vans',
		caption: 'Limo & Executive Seating',
		capacity: 'Up to 15',
		body: 'Sprinter van rental for small groups, Lake Geneva hotel shuttles, airport transfers and private transportation.',
		href: '/fleet/#limo-van',
		link: 'Explore Sprinter Rentals',
		image: photos.fleetLimoVan,
		imageAlt: alt.fleetLimoVan,
		alternate: photos.fleetLimoVanInterior,
	},
];

const sizes = '(max-width: 720px) 100vw, (max-width: 1140px) 50vw, 540px';
---

<section class="rv fsc">
	<div class="wrap wrap-1180">
		<SectionHeading
			eyebrow="Our Fleet"
			title="Trolleys, Buses and Shuttles for Every Occasion"
			tone="red"
		/>

		<ul class="fsc__grid">
			{
				cards.map((card) => (
					<li>
						<a class="fcard" href={card.href}>
							<div class="fcard__media">
								<Image class="fcard__img" src={card.image} alt={card.imageAlt} widths={[540, 800, 1080]} sizes={sizes} loading="lazy" />
								<Image class="fcard__img fcard__img--alt" src={card.alternate} alt="" widths={[540, 800, 1080]} sizes={sizes} loading="lazy" />
								<span class="fcard__cap">{card.capacity}</span>
								<span class="fcard__peek" aria-hidden="true">Interior</span>
							</div>
							<div class="fcard__body">
								<p class="fcard__kicker">{card.caption}</p>
								<h3 class="fcard__name">{card.name}</h3>
								<p class="fcard__text">{card.body}</p>
								<span class="link-gold fcard__more">{card.link} &rarr;</span>
							</div>
						</a>
					</li>
				))
			}
		</ul>

		<div class="fsc__cta">
			<a class="btn-gold" href="/fleet/">Explore the Full Fleet</a>
		</div>
	</div>
</section>

<style>
	/* After the reference's homepage fleet band: cream ground, two large cards a
	   row, centred copy under the photo and one button to the full fleet. */
	.fsc {
		padding: 32px 0 88px;
		background: var(--cream);
	}

	.fsc :global(.sh) {
		margin-bottom: 48px;
	}

	.fsc__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 30px;
		max-width: 1080px;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.fcard {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--line-2);
		border-radius: 4px;
		background: var(--paper);
		box-shadow: 0 2px 10px rgb(26 26 26 / 0.04);
		color: inherit;
		text-decoration: none;
		transition:
			box-shadow 0.35s,
			transform 0.35s,
			border-color 0.35s;
	}

	.fcard:hover {
		border-color: var(--gold-cream);
		box-shadow: 0 18px 44px rgb(26 26 26 / 0.13);
		transform: translateY(-4px);
	}

	.fcard__media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--line);
	}

	.fcard__img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 0.6s cubic-bezier(0.22, 0.6, 0.2, 1),
			opacity 0.45s ease;
	}

	.fcard__img--alt {
		opacity: 0;
	}

	.fcard:hover .fcard__img {
		transform: scale(1.04);
	}

	.fcard__cap,
	.fcard__peek {
		position: absolute;
		padding: 6px 12px;
		border-radius: 999px;
		font-size: 10.5px;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		backdrop-filter: blur(4px);
	}

	.fcard__cap {
		top: 16px;
		left: 16px;
		background: rgb(11 47 32 / 0.84);
		color: var(--gold-light);
	}

	.fcard__peek {
		right: 16px;
		bottom: 16px;
		border: 1px solid rgb(255 255 255 / 0.45);
		background: rgb(0 0 0 / 0.5);
		color: var(--gold-light);
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.35s,
			transform 0.35s;
	}

	/* The interior cross-fades in on hover. A touch screen has no hover to
	   leave, so the swap would stick after a tap. */
	@media (hover: hover) {
		.fcard:hover .fcard__img--alt,
		.fcard:focus-visible .fcard__img--alt,
		.fcard:hover .fcard__peek,
		.fcard:focus-visible .fcard__peek {
			opacity: 1;
		}
		.fcard:hover .fcard__peek,
		.fcard:focus-visible .fcard__peek {
			transform: none;
		}
	}

	.fcard__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: center;
		padding: 28px 32px 32px;
		text-align: center;
	}

	.fcard__kicker {
		margin: 0 0 9px;
		color: var(--gold-deep);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.26em;
		text-transform: uppercase;
	}

	.fcard__name {
		position: relative;
		margin: 0;
		padding-bottom: 10px;
		font-family: var(--serif);
		font-size: 27px;
		font-weight: 600;
		line-height: 1.1;
	}

	/* A short gold rule that draws in under the name on hover. */
	.fcard__name::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 0;
		height: 2px;
		background: var(--grad-gold);
		transform: translateX(-50%);
		transition: width 0.35s;
	}

	.fcard:hover .fcard__name::after,
	.fcard:focus-visible .fcard__name::after {
		width: 46px;
	}

	.fcard__text {
		flex: 1;
		max-width: 38ch;
		margin: 14px 0 0;
		color: var(--muted);
		font-size: 14.5px;
		font-weight: 300;
		line-height: 1.65;
	}

	.fcard__more {
		margin-top: 22px;
	}

	.fsc__cta {
		margin-top: 48px;
		text-align: center;
	}

	@media (hover: none) {
		.fcard__name::after {
			width: 46px;
		}
	}

	@media (width <= 720px) {
		.fsc {
			padding: 24px 0 64px;
		}
		.fsc__grid {
			grid-template-columns: 1fr;
			gap: 22px;
		}
		.fcard__body {
			padding: 24px 22px 28px;
		}
		.fsc__cta .btn-gold {
			display: block;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fcard,
		.fcard__img,
		.fcard__peek,
		.fcard__name::after {
			transition: none;
		}
	}
</style>
