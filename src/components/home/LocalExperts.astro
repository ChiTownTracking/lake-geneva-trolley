---
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { articles, localExpertsIntro, transportOptions } from '../../data/home';

const number = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="rv lx">
	<div class="wrap wrap-wide">
		<SectionHeading
			eyebrow="Your Local Experts for Trolley Rental & Transportation"
			title="Lake Geneva Trolley Rental & Transportation Services in Lake Geneva, WI"
			lead={localExpertsIntro}
			tone="red"
		/>

		<div class="lx__articles">
			{
				articles.map((article, i) => (
					<article class="lx__article">
						<span class="lx__num" aria-hidden="true">
							{number(i)}
						</span>
						<div class="lx__copy">
							<h3 class="lx__title">{article.title}</h3>
							<p class="lx__body">{article.body}</p>
							{article.points && (
								<ul class="lx__points">
									{article.points.map((point) => (
										<li>
											<Icon name="check" class="lx__check" />
											{point}
										</li>
									))}
								</ul>
							)}
						</div>
					</article>
				))
			}
		</div>

		<div class="lx__close">
			<div class="lx__options">
				<h3 class="lx__boxTitle">Frequently Chosen Transportation Options in Lake Geneva</h3>
				<ul class="lx__optionList">
					{
						transportOptions.map((option) => (
							<li>
								<a class="lx__option" href={option.href}>
									<Icon name="check" class="lx__check" />
									{option.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lx__reserve">
				<span class="lx__badge">
					<Icon name="bus" />
				</span>
				<div>
					<h3 class="lx__boxTitle lx__boxTitle--red">Reserve a Lake Geneva Trolley Today</h3>
					<p class="lx__reserveText">
						Request trolley rental in Lake Geneva, WI for your wedding, hotel guest shuttles
						or a private group outing. Send your date, passenger count and route for a free quote
						and a transportation plan tailored to your event.
					</p>
					<a class="btn-red lx__cta" href="#getquote">
						Get Your Free Quote Today
						<Icon name="arrow-long" />
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.lx {
		padding: 88px 0 92px;
		background: var(--paper);
	}

	.lx :global(.sh) {
		margin-bottom: 56px;
	}

	.lx :global(.sh__title) {
		max-width: 32ch;
		margin-inline: auto;
		line-height: 1.15;
	}

	.lx :global(.sh__lead) {
		max-width: 86ch;
	}

	.lx__articles {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 64px;
	}

	.lx__article {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 20px;
		padding: 30px 0;
		border-top: 1px solid var(--line-2);
	}

	.lx__num {
		color: var(--gold);
		font-family: var(--serif);
		font-size: 30px;
		font-style: italic;
		line-height: 1;
	}

	.lx__title {
		margin: 0;
		text-wrap: balance;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 23px;
		font-weight: 600;
		line-height: 1.22;
	}

	.lx__body {
		margin: 12px 0 0;
		color: var(--muted);
		font-size: 14.5px;
		font-weight: 300;
		line-height: 1.75;
	}

	.lx__points,
	.lx__optionList {
		display: grid;
		gap: 8px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}

	.lx__points li,
	.lx__option {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		color: var(--ink);
		font-size: 14px;
		font-weight: 400;
		line-height: 1.5;
	}

	.lx :global(.lx__check) {
		flex: none;
		width: 16px;
		height: 16px;
		margin-top: 2px;
		color: var(--brand-red);
	}

	.lx__close {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 22px;
		margin-top: 26px;
	}

	.lx__options,
	.lx__reserve {
		padding: 34px 36px;
		border-radius: 6px;
	}

	.lx__options {
		border: 1px solid var(--line-2);
		background: var(--cream);
	}

	.lx__optionList {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px 24px;
		margin-top: 22px;
	}

	.lx__option {
		color: var(--ink);
		text-decoration: none;
		transition: color 0.2s;
	}

	.lx__option:hover {
		color: var(--brand-red);
	}

	.lx__boxTitle {
		margin: 0;
		text-wrap: balance;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 25px;
		font-weight: 600;
		line-height: 1.2;
	}

	.lx__boxTitle--red {
		color: var(--brand-red);
	}

	/* The gold double rule of the reference's framed panels. */
	.lx__reserve {
		display: flex;
		align-items: flex-start;
		gap: 24px;
		border: 1px solid var(--gold);
		background: var(--paper);
		box-shadow:
			inset 0 0 0 5px var(--paper),
			inset 0 0 0 6px var(--gold-cream);
	}

	.lx__badge {
		display: grid;
		flex: none;
		place-items: center;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--brand-green);
		color: var(--gold-light);
	}

	.lx__badge :global(svg) {
		width: 30px;
		height: 30px;
	}

	.lx__reserveText {
		margin: 12px 0 0;
		color: var(--muted);
		font-size: 14.5px;
		font-weight: 300;
		line-height: 1.7;
	}

	.lx__cta {
		margin-top: 22px;
	}

	@media (width <= 1000px) {
		.lx__articles {
			gap: 0 40px;
		}
		.lx__close {
			grid-template-columns: 1fr;
		}
	}

	@media (width <= 760px) {
		.lx {
			padding: 60px 0 64px;
		}
		.lx :global(.sh) {
			margin-bottom: 36px;
		}
		.lx__articles {
			grid-template-columns: 1fr;
		}
		.lx__title {
			font-size: 21px;
		}
		.lx__options,
		.lx__reserve {
			padding: 26px 22px;
		}
	}

	@media (width <= 560px) {
		.lx__optionList {
			grid-template-columns: 1fr;
		}
		.lx__reserve {
			flex-direction: column;
		}
		.lx__cta {
			width: 100%;
		}
	}
</style>
