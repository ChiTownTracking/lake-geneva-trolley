---
import { Image } from 'astro:assets';
import { occasions } from '../data/content';
import { photos, alt } from '../data/images';
---

<section class="rv occasions">
	<div class="wrap wrap-1180 occasions__grid">
		<div class="occasions__media">
			<Image
				class="occasions__image"
				src={photos.occasions}
				alt={alt.occasions}
				widths={[500, 800, 1200]}
				sizes="(max-width: 800px) 100vw, 46vw"
				loading="lazy"
			/>
		</div>
		<div class="occasions__content">
			<div class="eyebrow center">
				<span class="eyebrow__rule"></span>
				<span class="eyebrow__label">Private Trolley Transportation</span>
				<span class="eyebrow__rule eyebrow__rule--r"></span>
			</div>
			<h2 class="h-section occasions__title">Made for the moments between destinations</h2>
			<p class="occasions__lead">
				A wedding weekend in lake country can spread across a hotel, a ceremony site, a stretch of
				shoreline and a reception hall. One vehicle keeps the group on one schedule, which is
				usually the difference between a relaxed afternoon and a series of separate arrivals.
			</p>
			<div class="occasions__list">
				{
					occasions.map((occasion) => (
						<article class="occasion">
							<h3 class="occasion__title">
								{occasion.href ? (
									<a class="occasion__link" href={occasion.href}>
										{occasion.title}
									</a>
								) : (
									occasion.title
								)}
							</h3>
							<p class="occasion__body">{occasion.body}</p>
						</article>
					))
				}
			</div>
			<a class="btn-gold occasions__cta" href="/#getquote">Plan Your Transportation</a>
		</div>
	</div>
</section>

<style>
	.occasions {
		padding: 56px 28px;
		background: var(--paper);
	}

	.occasions__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		align-items: stretch;
		min-height: 470px;
		padding-inline: 0;
	}

	.occasions__media {
		min-height: 470px;
		overflow: hidden;
	}

	.occasions__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.occasions__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(36px, 5vw, 68px);
		background: var(--cream);
	}

	.occasions__content .eyebrow {
		display: grid;
		grid-template-columns: minmax(24px, 1fr) auto minmax(24px, 1fr);
		gap: 16px;
		width: 100%;
	}

	.occasions__content .eyebrow__rule {
		width: 100%;
	}

	.occasions__content .eyebrow__label {
		line-height: 1.55;
		text-align: center;
	}

	.occasions__title {
		max-width: 18ch;
		margin: 18px 0;
		text-align: left;
	}

	.occasions__lead {
		max-width: 62ch;
		margin: 0;
		color: var(--muted);
		font-size: 15px;
		font-weight: 300;
		line-height: 1.75;
	}

	.occasions__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 28px;
		margin-top: 30px;
	}

	.occasion {
		padding: 18px 0;
		border-top: 1px solid var(--line-2);
	}

	.occasion__title {
		margin: 0 0 7px;
		font-family: var(--serif);
		font-size: 18px;
		font-weight: 600;
	}

	.occasion__link {
		color: inherit;
		text-decoration: none;
	}

	.occasion__link:hover {
		color: var(--gold-dark);
	}

	.occasion__body {
		margin: 0;
		color: var(--muted);
		font-size: 13.5px;
		font-weight: 300;
		line-height: 1.65;
	}

	.occasions__cta {
		display: inline-flex;
		align-self: flex-start;
		align-items: center;
		min-height: 44px;
		margin-top: 26px;
	}

	@media (width <= 800px) {
		.occasions__grid {
			grid-template-columns: 1fr;
			min-height: 0;
		}
		.occasions__media {
			min-height: 320px;
			max-height: 380px;
		}
		.occasions__content {
			padding: 38px 30px 42px;
		}
		.occasions__title {
			max-width: 20ch;
		}
	}

	@media (width <= 560px) {
		.occasions {
			padding: 42px 18px;
		}
		.occasions__media {
			min-height: 250px;
		}
		.occasions__content {
			padding: 32px 22px 36px;
		}
		.occasions__content .eyebrow {
			grid-template-columns: minmax(20px, 1fr) minmax(0, 22ch) minmax(20px, 1fr);
			gap: 12px;
		}
		.occasions__list {
			grid-template-columns: 1fr;
			margin-top: 24px;
		}
		.occasions__cta {
			align-self: stretch;
			justify-content: center;
		}
	}
</style>
