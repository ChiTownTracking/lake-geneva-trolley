---
/**
 * Client reviews carousel, in the slot the itinerary strip used to hold on the
 * homepage. One quote at a time; the viewport is a scroll-snap strip, so it
 * still swipes and still reads in order if the script never runs. Arrows and
 * dots are the enhancement on top.
 *
 * Metrics match the ChiTown Trolley testimonial section so the two sites read
 * as one family - see the note at the top of global.css. It sits directly on
 * the page with no section background.
 *
 * The quotes themselves are placeholders - see the notice above `testimonials`
 * in src/data/content.ts.
 */
import { testimonials } from '../data/content';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const many = testimonials.length > 1;
---

{
	testimonials.length > 0 && (
		<section class="rv tst">
			<div class="wrap">
				<SectionHeading eyebrow="Client Reviews" title="What groups say afterwards" />

				<div class="tstc" data-carousel>
					{many && (
						<button
							type="button"
							class="tstc__arrow"
							data-carousel-prev
							aria-label="Previous review"
						>
							<Icon name="arrow-left" />
						</button>
					)}

					<div class="tstc__viewport" data-carousel-viewport>
						<div class="tstc__track">
							{testimonials.map((t) => (
								<figure class="quote tstc__slide">
									<span class="quote__mark" aria-hidden="true">
										&ldquo;
									</span>
									<blockquote class="quote__text">{t.quote}</blockquote>
									<span class="quote__rule" aria-hidden="true" />
									<figcaption class="quote__attribution">
										<span class="quote__person">{t.person}</span>
										<span class="quote__role">{t.role}</span>
									</figcaption>
								</figure>
							))}
						</div>
					</div>

					{many && (
						<button
							type="button"
							class="tstc__arrow"
							data-carousel-next
							aria-label="Next review"
						>
							<Icon name="arrow-right" />
						</button>
					)}
				</div>

				{many && <div class="tstc__dots" data-carousel-dots />}
			</div>
		</section>
	)
}

<style>
	.tst {
		padding: 48px 5px;
	}

	.tst :global(.sh) {
		margin-bottom: 34px;
	}

	.tstc {
		display: flex;
		align-items: center;
		gap: 12px;
		max-width: 900px;
		margin: 0 auto;
	}

	/* Sized to the visible review by the script below; without it, the tallest. */
	.tstc__viewport {
		flex: auto;
		min-width: 0;
		overflow-x: auto;
		overflow-y: hidden;
		transition: height 0.35s ease;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
	}

	.tstc__viewport::-webkit-scrollbar {
		display: none;
	}

	/* Slides keep their own height rather than stretching to the tallest. */
	.tstc__track {
		display: flex;
		align-items: flex-start;
	}

	/* The figure carries both .quote and .tstc__slide, so both sets land here. */
	.tstc__slide {
		display: flex;
		flex: 0 0 100%;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 0;
		padding: 0 14px;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		text-align: center;
	}

	.quote__mark {
		margin-top: 20px;
		background: linear-gradient(100deg, var(--gold-dark), var(--gold));
		background-clip: text;
		font-family: var(--serif);
		font-size: 64px;
		line-height: 0.5;
		-webkit-text-fill-color: transparent;
	}

	.quote__text {
		max-width: 52ch;
		margin: 0;
		font-family: var(--serif);
		font-size: 20px;
		font-style: italic;
		font-weight: 400;
		line-height: 1.6;
	}

	.quote__rule {
		width: 40px;
		height: 1px;
		background: var(--grad-gold);
	}

	.quote__attribution {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 5px;
	}

	.quote__person {
		color: var(--ink);
		font-family: var(--serif);
		font-size: 16px;
		font-weight: 600;
	}

	.quote__role {
		color: var(--muted);
		font-size: 11.5px;
		letter-spacing: 0.26em;
		text-transform: uppercase;
	}

	.tstc__arrow {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 8px;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--gold-deep);
		line-height: 0;
		cursor: pointer;
		transition:
			color 0.25s,
			background 0.25s;
	}

	.tstc__arrow:hover {
		background: var(--cream);
		color: var(--gold-dark);
	}

	.tstc__arrow :global(svg) {
		width: 26px;
		height: 26px;
	}

	/* Dots are expanding bars rather than circles; the active one widens. */
	.tstc__dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	.tstc__dots :global(.tstc__dot) {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 44px;
		padding: 0;
		border: none;
		appearance: none;
		background: none;
		cursor: pointer;
		transition: width 0.3s ease-in-out;
	}

	.tstc__dots :global(.tstc__dot)::after {
		content: '';
		display: block;
		width: 100%;
		height: 3px;
		border-radius: 2px;
		background: rgb(212 175 106 / 0.28);
		transition: background-color 0.3s ease-in-out;
	}

	.tstc__dots :global(.tstc__dot:hover)::after {
		background: rgb(212 175 106 / 0.5);
	}

	.tstc__dots :global(.tstc__dot.is-active) {
		width: 44px;
	}

	.tstc__dots :global(.tstc__dot.is-active)::after {
		background: var(--gold-dark);
	}

	@media (width <= 640px) {
		.tstc {
			gap: 2px;
		}

		.tstc__slide {
			padding-inline: 0;
		}

		.tstc__arrow :global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tstc__viewport,
		.tstc__arrow,
		.tstc__dots :global(.tstc__dot),
		.tstc__dots :global(.tstc__dot)::after {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
		const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]');
		const slides = Array.from(root.querySelectorAll<HTMLElement>('.tstc__slide'));
		const dots = root.parentElement?.querySelector<HTMLElement>('[data-carousel-dots]');
		if (!viewport || slides.length < 2) return;

		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let index = 0;
		let settle = 0;

		// Fit the strip to one review, so a short quote doesn't sit in a tall box.
		const fit = () => {
			viewport.style.height = `${slides[index].offsetHeight}px`;
		};

		const go = (next: number) => {
			index = (next + slides.length) % slides.length;
			fit();
			viewport.scrollTo({
				left: index * viewport.clientWidth,
				behavior: reduced ? 'auto' : 'smooth',
			});
		};

		const dotEls = slides.map((_, i) => {
			const dot = document.createElement('button');
			dot.type = 'button';
			dot.className = 'tstc__dot';
			dot.setAttribute('aria-label', `Review ${i + 1} of ${slides.length}`);
			dot.addEventListener('click', () => go(i));
			dots?.append(dot);
			return dot;
		});

		/* The scroll position is the source of truth, so a swipe and an arrow
		   press both land in the same place. */
		const sync = () => {
			const at = Math.round(viewport.scrollLeft / Math.max(1, viewport.clientWidth));
			index = Math.min(slides.length - 1, Math.max(0, at));
			fit();
			dotEls.forEach((dot, n) => {
				dot.classList.toggle('is-active', n === index);
				if (n === index) dot.setAttribute('aria-current', 'true');
				else dot.removeAttribute('aria-current');
			});
		};

		viewport.addEventListener('scroll', () => {
			clearTimeout(settle);
			settle = window.setTimeout(sync, 90);
		});
		root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => go(index - 1));
		root.querySelector('[data-carousel-next]')?.addEventListener('click', () => go(index + 1));
		addEventListener('resize', sync);
		// Text rewraps when fonts load or the width changes; keep the height in step.
		const observer = new ResizeObserver(fit);
		slides.forEach((slide) => observer.observe(slide));
		sync();
	});
</script>
