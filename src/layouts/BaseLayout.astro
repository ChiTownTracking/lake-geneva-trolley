---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import FloatingQuote from '../components/FloatingQuote.astro';
import FormRuntime from '../components/FormRuntime.astro';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	structuredData?: Record<string, unknown> | null;
	/** Set false on pages that close with their own call to action. */
	showCtaBand?: boolean;
	ctaTitle?: string;
	ctaSub?: string;
}

const {
	title,
	description,
	canonical,
	structuredData = null,
	showCtaBand = true,
	ctaTitle = 'Hold your date on Geneva Lake',
	ctaSub =
		'Request a Lake Geneva trolley, bus or van rental quote with your date, passenger count and planned stops. We will review vehicle availability and your group transportation itinerary.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			document.documentElement.classList.add('reveal-ready');
		</script>
		<BaseHead
			title={title}
			description={description}
			canonical={canonical}
			structuredData={structuredData}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<div class="site">
			<TopBar />
			<Header />
			<main id="main-content">
				<slot />
			</main>
			{showCtaBand && <CtaBand title={ctaTitle} sub={ctaSub} variant="gold" />}
			<Footer />
		</div>
		<FloatingQuote />
		<FormRuntime />

		<script>
			// Reveal-on-scroll. `reveal-ready` (set in <head>) is what hides sections,
			// so every path that cannot animate removes it again rather than leaving
			// content invisible: reduced motion, no IntersectionObserver, or a throw.
			const unhide = () => document.documentElement.classList.remove('reveal-ready');

			try {
				const targets = document.querySelectorAll('.rv');
				const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				if (reduced || !('IntersectionObserver' in window) || !targets.length) {
					unhide();
				} else {
					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								entry.target.classList.add('in');
								observer.unobserve(entry.target);
							}
						},
						{ rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
					);
					targets.forEach((target) => observer.observe(target));

					// Safety net: anything still unrevealed after the page settles gets
					// shown anyway, so a missed callback can never swallow a section.
					window.addEventListener('load', () => {
						setTimeout(() => {
							for (const target of targets) {
								const rect = target.getBoundingClientRect();
								if (rect.top < window.innerHeight * 1.5) target.classList.add('in');
							}
						}, 600);
					});
				}
			} catch {
				unhide();
			}
		</script>
		<noscript>
			<style>
				.reveal-ready .rv {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</body>
</html>
