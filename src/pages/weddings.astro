---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WeddingQuote from '../components/WeddingQuote.astro';
import Icon from '../components/Icon.astro';
import { fleet } from '../data/fleet';
import weddingVenue from '../assets/photos/wedding-venue.webp';
import weddingVehicles from '../assets/photos/wedding-trolley-coach.webp';
import lakesideResort from '../assets/services/resort-aerial.jpg';
import weddingBoarding from '../assets/photos/occasions.jpg';

const trolley = fleet.find((vehicle) => vehicle.id === 'classic-trolley')!;
const coach = fleet.find((vehicle) => vehicle.id === 'super-coach-bus')!;
const quoteHref = `/?vehicle=${encodeURIComponent('White Trolley — Classic')}#getquote`;

const routes = [
	{
		label: trolley.name,
		title: 'A trolley for your wedding party',
		body: 'Your Lake Geneva wedding trolley rental connects getting ready, the ceremony and reception. Travel together as a wedding party, with Geneva Lake photo stops planned into your route.',
		steps: [
			{ title: 'Getting-ready pickup', body: 'Start your wedding trolley itinerary with a confirmed home, hotel or resort pickup.' },
			{ title: 'Arrive at the ceremony', body: 'Plan trolley boarding and travel time for arrival at your Lake Geneva ceremony venue.' },
			{ title: 'A pause for photographs', body: 'Add Geneva Lake photo locations to your wedding route, allowing time for access, parking and photographs.' },
			{ title: 'On to the reception', body: 'Travel together by wedding trolley from your photo stops to the reception venue.' },
		],
	},
	{
		label: coach.name,
		title: 'A coach for your wedding guests',
		body: 'Plan Lake Geneva wedding guest transportation with coach shuttles between hotels, the ceremony and reception. Coordinate pickup times and evening return runs around your guest count.',
		steps: [
			{ title: 'Hotel and resort pickups', body: 'Provide each Lake Geneva hotel or resort address and guest count to plan shuttle pickups.' },
			{ title: 'Welcome to the venue', body: 'Schedule your wedding guest shuttle to arrive before the ceremony begins.' },
			{ title: 'Time to celebrate', body: 'Confirm coach waiting arrangements and reception return times when booking your wedding transportation.', note: 'Planned around your evening' },
			{ title: 'Reception pickup', body: 'Meet your wedding guest shuttle at the confirmed reception loading point.' },
			{ title: 'Back to the hotel', body: 'Finish your guest shuttle itinerary with scheduled returns to each hotel or resort.' },
		],
	},
];

const questions = [
	{ q: 'How many people can ride together?', a: `The ${trolley.name} seats ${trolley.capacity} passengers. The ${coach.name} accommodates ${coach.capacityLabel}, depending on the assigned vehicle. Share separate headcounts for the wedding party and hotel guests so we can help you choose the right combination.` },
	{ q: 'Can we book a trolley and a coach together?', a: 'Yes. Request a Lake Geneva wedding trolley and coach bus together. The trolley can carry your wedding party while the coach provides hotel and venue guest shuttles. Both vehicles and schedules are subject to availability and confirmation.' },
	{ q: 'How long should we reserve the vehicles?', a: 'Start with your ceremony time, then allow for boarding, travel, photographs and the reception arrival. Guest shuttles may need a different schedule from the trolley. Include your evening return plans so both services can be quoted accurately.' },
	{ q: 'Can we include photo stops around Geneva Lake?', a: 'Yes, planned photo stops can be part of your itinerary when the route, vehicle access and charter length allow. Send the locations you have in mind so time for travel, parking and photographs can be included.' },
	{ q: 'Can you pick up at more than one hotel?', a: 'Multiple pickup points can be considered when planning your route. Include each address, the number of guests at each location and the required arrival time. Confirm loading access with the hotels and wedding venue before finalizing the schedule.' },
	{ q: 'When should we inquire about our date?', a: 'Request your Lake Geneva wedding transportation quote once your date and venues are confirmed. For an upcoming wedding, ask about available trolleys and coaches. Your quote reflects the vehicles, charter hours and full wedding itinerary.' },
];

const packageDetails = [
	{ title: 'A schedule that fits', body: 'Coordinate Lake Geneva ceremony transfers and evening hotel shuttles.' },
	{ title: 'Room for every stop', body: 'Plan trolley pickups, Geneva Lake photo stops and reception transfers.' },
	{ title: 'A comfortable journey', body: 'A wood-finished trolley cabin and reclining coach seats.' },
	{ title: 'Your own chauffeurs', body: 'Professional chauffeurs for your wedding trolley and guest shuttle.' },
];

const planning = [
	{ title: 'Start with your timeline', body: 'Share your ceremony time to plan wedding trolley pickups, boarding and travel between venues. Include time for Geneva Lake photographs and reception arrival.' },
	{ title: 'Put every stop on the map', body: 'List every hotel, photo stop and Lake Geneva wedding venue. Confirm trolley and coach loading points with each property before finalizing your route.' },
	{ title: 'Count both groups', body: 'Send separate passenger counts for your wedding trolley and guest shuttles. We will review coach capacity and vehicle availability for your Lake Geneva wedding.' },
];

const venues = ['Grand Geneva Resort & Spa', 'The Abbey Resort', 'Lake Lawn Resort', 'The Ridge Hotel', 'Local Country Clubs', 'Lakeside Private Estates', 'Lake Geneva Wedding Venues'];

const services = [
	{ icon: 'bus', title: 'Complete Wedding Transportation Solutions', body: 'We provide complete wedding transportation in Lake Geneva, WI, including guest shuttles, bridal party transportation, hotel transfers, ceremony to reception transportation and custom routes. Our trolleys are ideal for weddings of all sizes, from small intimate gatherings to large multi-venue celebrations.' },
	{ icon: 'map-pin', title: 'Serving All Lake Geneva Wedding Venues', body: 'Our wedding trolley rentals serve all major Lake Geneva venues, luxury resorts, country clubs, lakeside estates and private properties. We are familiar with the local area and can create the best routes to keep your wedding day running smoothly. Whether your ceremony, photos and reception are at one location or multiple locations, we’ll handle the transportation so you can focus on enjoying your special day.' },
	{ icon: 'shield', title: 'Professional, Reliable and Stress-Free', body: 'Our experienced chauffeurs are professional, punctual and dedicated to making your wedding day transportation seamless. We handle the logistics, traffic and parking, so you don’t have to. With our reliable service, you can be confident that your guests will arrive on time and together.' },
] as const;
---

<BaseLayout
	title="Lake Geneva Wedding Trolley Rental | Lake Geneva Trolley & Bus Rental"
	description="Lake Geneva wedding trolley rental and guest shuttle transportation. Plan hotel pickups, ceremony transfers, photo stops and reception returns with a quote."
	canonical="/weddings/"
	showCtaBand={false}
>
	<section class="whero">
		<Image src={weddingVenue} alt="Flowers and lanterns frame a wedding venue entrance at sunset." class="whero__image" widths={[760, 1200, 1909]} sizes="140vw" loading="eager" fetchpriority="high" />
		<div class="whero__overlay" aria-hidden="true"></div>
		<div class="wrap wrap-wide whero__content">
			<p class="whero__eyebrow"><span aria-hidden="true"></span>Your wedding, beautifully connected</p>
			<h1>Lake Geneva <em>Wedding Trolley</em> Rental</h1>
			<p class="whero__lead">Plan Lake Geneva wedding transportation with a private trolley for your wedding party and a coach bus for guests, from hotel pickups to reception returns.</p>
			<div class="whero__actions">
				<a class="btn-gold" href={quoteHref} data-wedding-quote>Check Wedding Availability</a>
				<a class="btn-ghost" href={trolley.detailHref}>Explore the Trolley</a>
			</div>
		</div>
	</section>

	<section class="wpackage" aria-labelledby="wedding-package-title">
		<div class="wrap wrap-1180">
			<SectionHeading eyebrow="The Wedding Package" title="Two vehicles. One wonderful day." id="wedding-package-title" lead="Pair a Lake Geneva wedding trolley rental with coach bus guest shuttles. Coordinate hotel pickups, ceremony transfers and reception returns for both groups." />
			<div class="wpackage__grid">
				<figure class="wpackage__photo">
					<Image src={weddingVehicles} alt="A white wedding trolley and coach pictured outside an elegant venue." widths={[360, 540, 720]} sizes="(max-width: 720px) calc(100vw - 40px), 480px" loading="lazy" />
					<figcaption class="wpackage__badge"><Icon name="heart" />The perfect pairing</figcaption>
				</figure>
				<div class="wpackage__content">
					<p class="wkicker">Your wedding transport</p>
					<div class="wpackage__vehicles">
						{[{ vehicle: trolley, letter: 'T', role: 'Wedding party' }, { vehicle: coach, letter: 'C', role: 'Guest shuttle' }].map(({ vehicle, letter, role }) => (
							<a class="wvehicle" href={vehicle.detailHref}>
								<span class="wvehicle__role">{role}</span>
								<span class="wvehicle__initial" aria-hidden="true">{letter}</span>
								<h3>{vehicle.name}</h3>
								<span class="wvehicle__capacity">{vehicle.capacityLabel}</span>
								<Icon name="arrow-long" class="wvehicle__arrow" />
							</a>
						))}
					</div>
					<h3 class="wpackage__subhead">Thoughtfully planned, together</h3>
					<ul class="wpackage__details">
						{packageDetails.map((item) => (
							<li>
								<span class="wcheck" aria-hidden="true"><Icon name="check" /></span>
								<div><strong>{item.title}</strong><span>{item.body}</span></div>
							</li>
						))}
					</ul>
					<div class="wpackage__action">
						<a class="btn-gold" href={quoteHref} data-wedding-quote>Get a Wedding Quote</a>
						<p>Tailored to your date,<br />your guests and your plans.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="wroutes" aria-labelledby="wedding-routes-title">
		<div class="wrap wrap-1180">
			<SectionHeading eyebrow="Every Part of Your Day" title="Two routes, one celebration" id="wedding-routes-title" tone="light" lead="Plan separate Lake Geneva wedding transportation routes for your party and guests, with trolley photo stops and coach shuttles coordinated around the same celebration." />
			<div class="wroutes__grid">
				{routes.map((route, routeIndex) => (
					<article class="wroute">
						<header class="wroute__head">
							<span class="wroute__icon" aria-hidden="true"><Icon name={routeIndex === 0 ? 'heart' : 'users'} /></span>
							<div>
								<p class="wkicker">{route.label}</p>
								<h3>{route.title}</h3>
							</div>
						</header>
						<p class="wroute__intro">{route.body}</p>
						<ol class="wroute__stops">
							{route.steps.map((step, index) => (
								<li class:list={['wroute__stop', { 'wroute__stop--pause': 'note' in step }]}>
									<span class="wroute__number" aria-hidden="true">{index + 1}</span>
									{'note' in step && <span class="wroute__note">{step.note}</span>}
									<h4>{step.title}</h4>
									<p>{step.body}</p>
								</li>
							))}
						</ol>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="wplanning" aria-labelledby="wedding-planning-title">
		<div class="wrap wrap-1180">
			<SectionHeading eyebrow="A Few Thoughtful Details" title="Less to organize. More to enjoy." id="wedding-planning-title" />
			<ol class="wplanning__grid">
				{planning.map((item, index) => (
					<li class="wplanning__item">
						<span class="wplanning__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="wfaq" aria-labelledby="wedding-faq-title">
		<div class="wrap wrap-1180 wfaq__layout">
			<div class="wfaq__intro">
				<SectionHeading eyebrow="Wedding Transportation Questions" title="A few details before the big day" id="wedding-faq-title" align="left" />
			</div>
			<div class="wfaq__list">
				{questions.map((item) => (
					<details class="wfaq__item" name="wedding-faq">
						<summary>{item.q}<span class="wfaq__toggle" aria-hidden="true"><Icon name="plus" /></span></summary>
						<p>{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="wvenues" aria-labelledby="wedding-venues-title">
		<div class="wrap wrap-1180 wvenues__grid">
			<figure class="wvenues__photo">
				<Image src={lakesideResort} alt="Aerial view of a Lake Geneva area resort, golf course and lake." widths={[480, 720, 1000]} sizes="(max-width: 860px) calc(100vw - 40px), 540px" loading="lazy" />
			</figure>
			<div class="wvenues__content">
				<SectionHeading eyebrow="Serving Top Wedding Venues" title="Lake Geneva Wedding Venues We Frequently Serve" id="wedding-venues-title" align="left" lead="We provide wedding trolley rentals to all major Lake Geneva venues and surrounding areas, including hotels, resorts, private estates and lakeside locations." />
				<ul class="wvenues__list">
					{venues.map((venue) => (
						<li><span class="wcheck wcheck--red" aria-hidden="true"><Icon name="check" /></span>{venue}</li>
					))}
					<li class="wvenues__more"><span class="wcheck wcheck--red" aria-hidden="true"><Icon name="plus" /></span>And More!</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="wstory" aria-labelledby="wedding-story-title">
		<div class="wrap wrap-1180">
			<div class="wstory__intro">
				<SectionHeading eyebrow="Lake Geneva Wedding Trolley Rental" title="Elegant, Convenient and Memorable Wedding Transportation" id="wedding-story-title" tone="red" />
				<p class="wstory__lead">Your wedding day is one of the most important days of your life, and every detail matters — including how you and your guests get from one place to another.</p>
				<div class="wstory__columns">
					<p>Our Lake Geneva wedding trolley rental service offers a unique, stylish and stress-free way to transport your wedding party and guests. Whether you’re planning an intimate ceremony or a large celebration, our trolleys provide the perfect combination of charm, comfort and reliability.</p>
					<p>Lake Geneva is one of the most beautiful wedding destinations in Wisconsin, with stunning lake views, historic venues, luxury resorts and scenic photography locations. Our wedding trolleys make it easy to move between these locations while giving your guests a memorable experience they’ll talk about for years.</p>
				</div>
			</div>

			<div class="wstory__why">
				<div class="wstory__why-text">
					<p class="wkicker">Charm meets convenience</p>
					<h3>Why a Wedding Trolley is the Perfect Choice in Lake Geneva</h3>
					<p>A wedding trolley brings timeless, vintage charm to your celebration while keeping everyone together. Instead of coordinating separate cars and drivers, your wedding party and guests ride as one group and arrive at each location on time and in style.</p>
					<p>Our trolleys also make a beautiful backdrop for wedding photos, and the open, social seating keeps the celebration going between the ceremony, photo stops and the reception.</p>
				</div>
				<figure class="wstory__photo">
					<Image src={weddingBoarding} alt="A bride and groom board a white wedding trolley beside the lake." widths={[480, 720, 1000]} sizes="(max-width: 860px) calc(100vw - 40px), 540px" loading="lazy" />
				</figure>
			</div>

			<div class="wstory__cards">
				{services.map((item) => (
					<article class="wstory__card">
						<span class="wstory__card-icon" aria-hidden="true"><Icon name={item.icon} /></span>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="wcta" aria-labelledby="wedding-cta-title">
		<div class="wrap wrap-1180 wcta__inner">
			<div class="wcta__text">
				<p class="wcta__kicker">Let’s bring your wedding day together</p>
				<h2 id="wedding-cta-title">Book Your Lake Geneva Wedding Trolley Rental Today</h2>
				<p>If you’re looking for the best <strong>wedding trolley rental in Lake Geneva</strong>, WI, we’re here to help. Contact us today to get a free quote, check availability and plan your wedding transportation. Let us make your special day even more memorable with our beautiful, reliable and professional trolley service.</p>
			</div>
			<div class="wcta__action">
				<a class="btn-invert" href={quoteHref} data-wedding-quote>Request Your Wedding Quote</a>
				<p>Request a Lake Geneva wedding trolley and guest shuttle quote with your date, venues and passenger counts.</p>
			</div>
		</div>
	</section>

	<WeddingQuote />
</BaseLayout>

<style>
	/* ---- Hero ---- */
	.whero { position: relative; isolation: isolate; overflow: hidden; background: #211c16; }
	.whero__image { position: absolute; z-index: -2; top: 0; right: 0; width: 140%; max-width: none; height: 100%; object-fit: cover; object-position: right center; }
	.whero__overlay { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgb(17 16 12 / 90%), rgb(17 16 12 / 62%) 55%, rgb(17 16 12 / 12%)), linear-gradient(0deg, rgb(17 16 12 / 55%), transparent 40%); }
	.whero__content { padding-block: 104px 96px; }
	.whero__eyebrow { display: flex; align-items: center; gap: 14px; margin: 0 0 20px; color: var(--gold-light); font-size: 11px; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; }
	.whero__eyebrow span { width: 40px; height: 1px; background: var(--gold); }
	.whero h1 { max-width: 780px; margin: 0; color: var(--paper); font: 500 clamp(40px, 5.2vw, 72px)/1.04 var(--serif); }
	.whero h1 em { color: var(--gold-light); font-style: italic; font-weight: 400; }
	.whero__lead { max-width: 52ch; margin: 24px 0 32px; color: #f3eee5; font-size: 17px; font-weight: 300; line-height: 1.7; }
	.whero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
	.whero__actions .btn-ghost { border-color: rgb(240 217 168 / 65%); color: var(--paper); background: rgb(20 18 13 / 25%); }
	.whero__actions .btn-ghost:hover { background: rgb(240 217 168 / 15%); }

	/* ---- Shared ---- */
	.wkicker { margin: 0 0 14px; color: var(--gold-deep); font-size: 10px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; }
	.wcheck { display: grid; flex: 0 0 26px; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--gold-cream); color: var(--gold-deep); }
	.wcheck :global(svg) { width: 14px; height: 14px; stroke-width: 2.4; }
	.wcheck--red { background: var(--brand-red); color: #fff; }

	/* ---- Package ---- */
	.wpackage { padding: 88px 0; background: radial-gradient(ellipse at top left, #f4ecdc, transparent 65%), var(--cream); }
	.wpackage__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 72px; align-items: center; }
	.wpackage__photo { position: relative; margin: 0 0 0 18px; }
	.wpackage__photo::before { content: ''; position: absolute; z-index: 0; inset: -18px 18px 18px -18px; border: 1px solid var(--gold); border-radius: 16px; }
	.wpackage__photo img { position: relative; display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 14px; box-shadow: 0 24px 60px rgb(49 38 15 / 16%); }
	.wpackage__badge { position: absolute; right: -22px; bottom: 34px; display: flex; align-items: center; gap: 9px; padding: 13px 18px; border-radius: 40px; background: var(--paper); box-shadow: 0 12px 30px rgb(49 38 15 / 14%); color: var(--gold-deep); font-size: 10px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; }
	.wpackage__badge :global(svg) { width: 16px; height: 16px; color: var(--brand-red); }
	.wpackage__vehicles { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
	.wvehicle { position: relative; display: flex; flex-direction: column; align-items: flex-start; padding: 22px 20px 20px; border: 1px solid var(--line-2); border-radius: 12px; background: var(--paper); color: inherit; text-decoration: none; transition: border-color .2s, transform .2s, box-shadow .2s; }
	.wvehicle:hover { border-color: var(--gold); box-shadow: 0 14px 30px rgb(49 38 15 / 9%); transform: translateY(-2px); }
	.wvehicle__role { position: absolute; top: 16px; right: 16px; padding: 5px 10px; border-radius: 20px; background: var(--cream); color: var(--gold-deep); font-size: 10px; font-weight: 500; letter-spacing: .06em; }
	.wvehicle__initial { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 16px; border-radius: 50%; background: var(--grad-gold); color: #fff; font: 600 21px var(--serif); }
	.wvehicle h3 { margin: 0 0 4px; font: 600 23px/1.1 var(--serif); }
	.wvehicle__capacity { color: var(--muted); font-size: 13px; }
	.wvehicle :global(.wvehicle__arrow) { position: absolute; right: 18px; bottom: 18px; width: 18px; height: 18px; color: var(--gold-dark); transition: transform .2s; }
	.wvehicle:hover :global(.wvehicle__arrow) { transform: translateX(3px); }
	.wpackage__subhead { margin: 36px 0 18px; font: 500 28px/1.2 var(--serif); }
	.wpackage__details { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 26px; margin: 0; padding: 0; list-style: none; }
	.wpackage__details li { display: flex; gap: 13px; font-size: 14px; line-height: 1.5; }
	.wpackage__details strong { display: block; font-weight: 500; }
	.wpackage__details li span:not(.wcheck) { display: block; margin-top: 3px; color: var(--muted); font-size: 13px; font-weight: 300; }
	.wpackage__action { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 34px; padding-top: 28px; border-top: 1px solid var(--line-2); }
	.wpackage__action p { margin: 0; color: var(--gold-deep); font: italic 16px/1.35 var(--serif); }

	/* ---- Routes ---- */
	.wroutes { padding: 96px 0; background: radial-gradient(ellipse at 85% 0%, rgb(212 175 106 / 14%), transparent 55%), var(--brand-green-deep); color: var(--paper); }
	.wroutes__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
	.wroute { padding: 36px 34px; border: 1px solid rgb(240 217 168 / 18%); border-radius: 16px; background: rgb(255 255 255 / 4%); }
	.wroute__head { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
	.wroute__icon { display: grid; flex: 0 0 52px; place-items: center; height: 52px; border: 1px solid rgb(240 217 168 / 40%); border-radius: 50%; color: var(--gold-light); }
	.wroute__icon :global(svg) { width: 22px; height: 22px; }
	.wroute .wkicker { margin-bottom: 6px; color: var(--gold); }
	.wroute h3 { margin: 0; font: 500 29px/1.15 var(--serif); }
	.wroute__intro { margin: 0 0 30px; padding-bottom: 26px; border-bottom: 1px solid rgb(240 217 168 / 15%); color: rgb(253 252 250 / 72%); font-size: 14px; font-weight: 300; line-height: 1.8; }
	.wroute__stops { margin: 0; padding: 0 0 0 14px; list-style: none; }
	.wroute__stop { position: relative; padding: 0 0 26px 30px; border-left: 1px dashed rgb(212 175 106 / 55%); }
	.wroute__stop:last-child { padding-bottom: 0; border-left-color: transparent; }
	.wroute__number { position: absolute; top: -2px; left: -14px; display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid var(--gold); border-radius: 50%; background: var(--brand-green-deep); color: var(--gold-light); font: 600 14px var(--serif); }
	.wroute__stop:last-child .wroute__number { border-color: transparent; background: var(--grad-gold); color: #241c0e; }
	.wroute__stop h4 { margin: 0 0 5px; font: 600 19px/1.3 var(--serif); }
	.wroute__stop p { margin: 0; color: rgb(253 252 250 / 66%); font-size: 13px; font-weight: 300; line-height: 1.7; }
	.wroute__stop--pause > h4, .wroute__stop--pause > p, .wroute__stop--pause > .wroute__note { position: relative; }
	.wroute__stop--pause::before { content: ''; position: absolute; z-index: 0; inset: -12px -14px 14px 16px; border-radius: 10px; background: rgb(240 217 168 / 9%); pointer-events: none; }
	.wroute__note { display: block; margin-bottom: 6px; color: var(--gold); font-size: 9px; font-weight: 500; letter-spacing: .17em; text-transform: uppercase; }

	/* ---- Planning ---- */
	.wplanning { padding: 92px 0; }
	.wplanning__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 0; padding: 0; list-style: none; counter-reset: none; }
	.wplanning__item { position: relative; padding: 34px 30px 32px; border: 1px solid var(--line-2); border-top: 3px solid var(--gold); border-radius: 4px 4px 14px 14px; background: var(--paper); box-shadow: 0 14px 40px rgb(49 38 15 / 6%); }
	.wplanning__number { display: block; color: transparent; background: var(--grad-text); background-clip: text; -webkit-background-clip: text; font: italic 500 54px/1 var(--serif); }
	.wplanning__item h3 { margin: 18px 0 12px; font: 500 25px/1.15 var(--serif); }
	.wplanning__item p { margin: 0; color: var(--muted); font-size: 14px; font-weight: 300; line-height: 1.8; }

	/* ---- FAQ ---- */
