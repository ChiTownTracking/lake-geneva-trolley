---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import LightString from '../components/LightString.astro';
import { fleet } from '../data/fleet';
import street from '../assets/christmas/christmas-street.webp';
import exterior from '../assets/christmas/christmas-exterior.webp';
import interior from '../assets/christmas/christmas-interior.webp';

const trolley = fleet.find((vehicle) => vehicle.id === 'christmas-trolley')!;
const vehicleParam = encodeURIComponent(trolley.quoteValue);
const quoteHref = `/?vehicle=${vehicleParam}#getquote`;
const reserveHref = `/reservation/?vehicle=${vehicleParam}`;

// Feature carousel: the interior leads, then the exterior.
const slides = [
	{ image: interior, alt: 'Inside the Christmas Trolley: black quilted perimeter benches beneath a wood ceiling lined with colored lights.', caption: 'Inside the trolley', position: 'center 24%' },
	{ image: exterior, alt: 'The Christmas Trolley at dusk, with strings of colored lights along its roofline and arched windows.', caption: 'Dressed for the season', position: '40% center' },
];

// Feature icons (snowflake, ornament, gift) cycle gold, green, red, as on the ChiTown page.
const icons = [
	{ path: 'M12 2v20M4 6l16 12M20 6L4 18M12 5l-2.5-2M12 5l2.5-2M12 19l-2.5 2M12 19l2.5 2M6.2 7.6l-3.2.9M6.2 16.4l-3.2-.9M17.8 7.6l3.2.9M17.8 16.4l3.2-.9' },
	{ circle: true, path: 'M10 6.5V4.8c0-.5.4-.8.9-.8h2.2c.5 0 .9.3.9.8v1.7M9 11c1 1 5 1 6 0' },
	{ rect: true, path: 'M4 13h16M12 9v12M12 9s-4 0-5.2-1.6C5.6 5.8 7 4 8.6 4.6 10.4 5.3 12 9 12 9Zm0 0s4 0 5.2-1.6C18.4 5.8 17 4 15.4 4.6 13.6 5.3 12 9 12 9Z' },
];

const features = [
	{ title: 'Reserved for your group', body: 'Private Christmas trolley rental for your Lake Geneva group, reserved as one charter.' },
	{ title: `Seats ${trolley.capacity} guests`, body: 'Bring family, friends or coworkers together for a Lake Geneva holiday lights outing.' },
	{ title: 'Circular perimeter seating', body: 'Everyone faces one another, so the conversation keeps going.' },
	{ title: 'Enclosed and heated', body: 'Stay warm between stops, however cold the evening gets.' },
	{ title: 'Bluetooth sound system', body: 'Bring your holiday playlist along for the ride.' },
	{ title: 'Christmas lights inside and out', body: 'Glowing from the roofline to the cabin ceiling.' },
];

const steps = [
	{ title: 'Gather everyone', body: 'Start your Lake Geneva Christmas trolley tour at a home, hotel or restaurant. Include any additional group pickups in your route request.' },
	{ title: 'Tour the lights', body: 'Choose the Lake Geneva neighborhoods and Christmas light displays you want to visit. We will review the route and timing for your private trolley tour.' },
	{ title: 'Pause along the way', body: 'Request dinner, refreshments or photo stops as part of your Christmas lights trolley itinerary.' },
	{ title: 'Home for the holidays', body: 'Arrange return stops for your group before your Lake Geneva holiday trolley charter begins.' },
];

const occasions = ['Family traditions', 'Office holiday parties', 'Friends’ nights out', 'Holiday date nights', 'Neighborhood gatherings'];

const questions = [
	{ q: 'Is the Christmas Trolley a private tour?', a: 'Yes. Our Lake Geneva Christmas Trolley tours are private group charters. Reserve the trolley for your party and request your preferred lights route, stops and playlist. Individual seats are not sold.' },
	{ q: 'How many guests fit on the Christmas Trolley?', a: `The Christmas Trolley seats ${trolley.capacity} guests on circular perimeter seating. If your group is larger, mention it in your request and we’ll review the options with you.` },
	{ q: 'Can we choose our Christmas lights route?', a: 'Yes. Send the neighborhoods, Christmas displays and stops for your Lake Geneva trolley tour of lights. We will review your pickup location, timing, road access and parking before confirming the itinerary.' },
	{ q: 'Will we stay warm?', a: 'The cabin is fully enclosed and heated, so your group can stay comfortable between stops. Dress for the weather if you plan to step out for photos.' },
	{ q: 'Can we bring our own drinks?', a: 'Tell us if your group plans to bring beverages, and we’ll confirm what’s allowed on your charter. Anyone drinking alcohol must be 21 or older.' },
	{ q: 'Where does the Christmas Trolley pick up?', a: 'Christmas trolley pickups are planned around Lake Geneva and surrounding communities. Send your pickup address and chosen holiday displays so we can confirm the route and availability for your date.' },
	{ q: 'How early should we reserve?', a: 'The Christmas Trolley is a seasonal vehicle with a limited number of holiday evenings, so request your preferred date as soon as your plans take shape. If your date is coming up soon, you can still ask about availability.' },
];
---

<BaseLayout
	title="Lake Geneva Christmas Trolley Tours | Private Holiday Lights Tours"
	description={`Plan a private trolley tour of lights in Lake Geneva for ${trolley.capacity} guests. Ride a heated Christmas Trolley with your chosen stops. Request a quote.`}
	canonical="/christmas-trolley/"
	showCtaBand={false}
>
	<section class="xhero" aria-labelledby="xmas-title">
		<div class="wrap wrap-wide xhero__copy">
			<p class="xkicker">A Lake Geneva holiday tradition</p>
			<h1 id="xmas-title">Lake Geneva<br /><em>Christmas Trolley</em> Tours</h1>
			<div class="xhero__actions">
				<a class="btn-gold" href={quoteHref}>Check Holiday Availability</a>
			</div>
		</div>
		<LightString class="xhero__lights" />
		<figure class="wrap wrap-wide xhero__scene">
			<Image src={street} alt="The white Christmas Trolley, trimmed in colored lights, parked on a snowy street beside a glowing Christmas tree at dusk." widths={[640, 960, 1400, 1919]} sizes="(max-width: 1240px) calc(100vw - 40px), 1184px" loading="eager" fetchpriority="high" />
			<figcaption>Limited seasonal dates</figcaption>
		</figure>
	</section>

	<section class="xfeatures" aria-labelledby="xmas-features-title">
		<div class="wrap wrap-wide xfeatures__inner">
			<div class="xfeatures__photo xcarousel" data-xcarousel role="region" aria-roledescription="carousel" aria-label="Christmas Trolley photos">
				<div class="xcarousel__slides">
					{slides.map((slide, index) => (
						<figure class:list={['xcarousel__slide', { 'is-active': index === 0 }]} data-xcarousel-slide aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}: ${slide.caption}`}>
							<Image src={slide.image} alt={slide.alt} widths={[480, 760, 1100, 1448]} sizes="(max-width: 860px) calc(100vw - 40px), 560px" loading="lazy" style={`object-position: ${slide.position}`} />
						</figure>
					))}
				</div>
				<span class="xfeatures__badge">{trolley.capacityLabel}</span>
				<div class="xcarousel__controls" data-xcarousel-controls hidden>
					<button type="button" class="xcarousel__arrow" data-xcarousel-prev aria-label="Previous photo">&larr;</button>
					<button type="button" class="xcarousel__arrow" data-xcarousel-next aria-label="Next photo">&rarr;</button>
					<div class="xcarousel__dots">
						{slides.map((slide, index) => (
							<button type="button" class="xcarousel__dot" data-xcarousel-dot={index} aria-label={`Show photo ${index + 1}: ${slide.caption}`} aria-pressed={index === 0 ? 'true' : 'false'}></button>
						))}
					</div>
					<p class="xcarousel__status" data-xcarousel-status aria-live="polite" aria-atomic="true">{slides[0].caption}</p>
				</div>
			</div>
			<div class="xfeatures__copy">
				<p class="xkicker xkicker--dark">The Christmas Trolley</p>
				<h2 id="xmas-features-title">Everything the season<br /><em>calls for.</em></h2>
				<p class="xfeatures__lead">A classic trolley dressed for the holidays, with a warm cabin, room for the whole group and a string of lights on every edge.</p>
				<ul class="xfeatures__list">
					{features.map((feature, index) => {
						const icon = icons[index % icons.length];
						return (
							<li>
								<h3>
									<svg class="xfeatures__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
										{icon.circle && <circle cx="12" cy="13.5" r="7" />}
										{icon.rect && <rect x="4" y="9" width="16" height="12" rx="1" />}
										<path d={icon.path} />
									</svg>
									{feature.title}
								</h3>
								<p>{feature.body}</p>
							</li>
						);
					})}
				</ul>
				<p class="xfeatures__note"><a href={quoteHref}><span aria-hidden="true">✦</span> Limited seasonal availability. Book early. <span class="xfeatures__arrow" aria-hidden="true">→</span></a></p>
			</div>
		</div>
	</section>

	<section class="xtour" aria-labelledby="xmas-tour-title">
		<div class="wrap wrap-wide xtour__inner">
			<div class="xtour__copy">
				<p class="xkicker">Private holiday lights tour</p>
				<h2 id="xmas-tour-title">Plan a lights route<br />for your group.</h2>
				<p class="xtour__lead">Create a private trolley tour of lights in Lake Geneva with your chosen neighborhoods, holiday displays and stops. We will review the route, pickup schedule and charter hours for your group.</p>
				<ol class="xtour__steps">
					{steps.map((step, index) => (
						<li><span class="xtour__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>
					))}
				</ol>
				<div class="xtour__occasions">
					<p>Made for</p>
					<ul>{occasions.map((occasion) => <li>{occasion}</li>)}</ul>
				</div>
			</div>
			<figure class="xtour__photo">
				<Image src={interior} alt="Inside the Christmas Trolley: black quilted perimeter benches beneath a wood ceiling lined with colored lights." widths={[420, 640, 900, 1086]} sizes="(max-width: 860px) calc(100vw - 40px), 480px" loading="lazy" />
			</figure>
		</div>
	</section>

	<Faq eyebrow="Christmas Trolley Questions" title="Before your holiday lights tour" items={questions} />

	<section class="xcta" aria-labelledby="xmas-cta-title">
		<LightString class="xcta__lights" />
		<div class="wrap xcta__inner">
			<p class="xkicker">Seasonal dates are limited</p>
			<h2 id="xmas-cta-title">Reserve your <em>Christmas Trolley</em></h2>
			<p>Request a Lake Geneva Christmas Trolley rental quote with your group size, pickup address, preferred evening and holiday lights route.</p>
			<div class="xcta__actions">
				<a class="btn-gold" href={quoteHref}>Request a Christmas Trolley Quote</a>
				<a class="xcta__link" href={reserveHref}>Or make a reservation request <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	document.querySelectorAll<HTMLElement>('[data-xcarousel]').forEach((carousel) => {
		const slides = [...carousel.querySelectorAll<HTMLElement>('[data-xcarousel-slide]')];
		const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-xcarousel-dot]')];
		const controls = carousel.querySelector<HTMLElement>('[data-xcarousel-controls]');
		const status = carousel.querySelector<HTMLElement>('[data-xcarousel-status]');
		if (!controls || slides.length < 2) return;
		const captions = slides.map((slide) => slide.getAttribute('aria-label')?.split(': ').slice(1).join(': ') ?? '');
		let current = 0;
		const show = (index: number) => {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
			dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === current)));
			if (status) status.textContent = captions[current];
		};
		carousel.querySelector('[data-xcarousel-prev]')?.addEventListener('click', () => show(current - 1));
		carousel.querySelector('[data-xcarousel-next]')?.addEventListener('click', () => show(current + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
		carousel.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
			if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
		});
		// Horizontal swipe on touch screens.
		let startX: number | null = null;
		carousel.addEventListener('pointerdown', (event) => { if (event.pointerType !== 'mouse') startX = event.clientX; });
		carousel.addEventListener('pointerup', (event) => {
			if (startX === null) return;
			const delta = event.clientX - startX;
			startX = null;
			if (Math.abs(delta) > 40) show(current + (delta < 0 ? 1 : -1));
		});
		carousel.addEventListener('pointercancel', () => { startX = null; });
		controls.hidden = false;
	});
</script>

<style>
	.xhero, .xtour, .xcta { --night: #10232c; --night-2: #17313c; --snow: #e6ecee; }
	.xkicker { margin: 0 0 20px; color: var(--gold-light); font-size: 11px; font-weight: 500; letter-spacing: .28em; line-height: 1.7; text-transform: uppercase; }
	.xkicker--dark { color: var(--gold-deep); }
	.xhero h1 em, .xfeatures h2 em, .xcta h2 em { color: var(--gold-light); font-weight: 400; }
	.xfeatures h2 em { color: var(--gold-deep); }

	/* Hero: a winter-night panel that opens onto the panorama. */
	.xhero { position: relative; overflow: hidden; padding-top: 44px; background: radial-gradient(ellipse 70% 60% at 50% 0%, #1f4250, transparent 70%), var(--night); color: var(--paper); text-align: center; }
	.xhero::after { content: ''; position: absolute; right: 0; bottom: 0; left: 0; z-index: 0; height: 120px; background: var(--cream); }
	.xhero__copy { position: relative; z-index: 1; }
	.xhero h1 { margin: 0; font: 500 clamp(44px, 5.6vw, 80px)/1.02 var(--serif); letter-spacing: -.02em; }
	.xhero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 32px; }
	.xhero__lights { position: relative; z-index: 1; margin-top: 44px; }
	.xhero__scene { position: relative; z-index: 1; margin-block: 14px 0; }
	.xhero__scene img { display: block; width: 100%; height: clamp(300px, 40vw, 506px); object-fit: cover; object-position: 60% center; border-radius: 140px 140px 0 0; }
	.xhero__scene figcaption { position: absolute; right: 48px; bottom: 22px; padding: 11px 16px; background: rgb(16 35 44 / 88%); color: var(--gold-light); font-size: 10px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }

	/* Features */
	.xfeatures { padding: 80px 0 88px; background: var(--cream); }
	.xfeatures__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: 64px; }
	.xfeatures__photo { position: relative; margin: 0; }
	.xcarousel__slides { position: relative; overflow: hidden; touch-action: pan-y; aspect-ratio: 4 / 3.4; border-radius: 0 0 120px 0; background: var(--night, #10232c); }
	.xcarousel__slide { position: absolute; inset: 0; margin: 0; opacity: 0; visibility: hidden; transition: opacity .6s ease, visibility 0s linear .6s; }
	.xcarousel__slide.is-active { opacity: 1; visibility: visible; transition: opacity .6s ease, visibility 0s; }
	.xcarousel__slide img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.xcarousel__controls { position: absolute; bottom: 20px; left: 20px; display: flex; align-items: center; gap: 8px; max-width: calc(100% - 140px); padding: 6px 14px 6px 6px; background: rgb(16 35 44 / 86%); color: var(--paper); }
	.xcarousel__controls[hidden] { display: none; }
	.xcarousel__arrow { display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 1px solid rgb(240 217 168 / 45%); background: transparent; color: var(--paper); font-size: 18px; cursor: pointer; transition: background .2s; }
	.xcarousel__arrow:hover { background: rgb(240 217 168 / 18%); }
	.xcarousel__dots { display: flex; gap: 2px; margin-left: 4px; }
	.xcarousel__dot { position: relative; width: 24px; height: 40px; padding: 0; border: 0; background: transparent; cursor: pointer; }
	.xcarousel__dot::before { content: ''; position: absolute; top: 50%; left: 50%; width: 7px; height: 7px; border-radius: 50%; background: rgb(240 217 168 / 40%); transform: translate(-50%, -50%); transition: background .2s, width .2s; }
	.xcarousel__dot[aria-pressed='true']::before { width: 18px; border-radius: 4px; background: var(--gold-light); }
	.xcarousel__status { margin: 0 0 0 10px; overflow: hidden; color: #dfe6e8; font-size: 12px; letter-spacing: .06em; text-overflow: ellipsis; white-space: nowrap; }
	.xcarousel :focus-visible { outline: 2px solid var(--gold-light); outline-offset: 2px; }
	.xfeatures__badge { position: absolute; top: 22px; left: 22px; padding: 10px 14px; background: rgb(253 252 250 / 72%); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); color: var(--lake-deep); font: 500 17px var(--serif); box-shadow: 0 6px 18px rgb(15 37 39 / 16%); }
	.xfeatures h2 { margin: 0; color: var(--lake-deep); font: 500 clamp(34px, 3.6vw, 50px)/1.08 var(--serif); }
	.xfeatures__lead { max-width: 52ch; margin: 20px 0 30px; color: var(--muted); font-size: 15px; font-weight: 300; line-height: 1.8; }
	.xfeatures__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 34px; margin: 0; padding: 0; list-style: none; }
	.xfeatures__list li { padding-top: 16px; border-top: 1px solid var(--line-2); }
	.xfeatures__list h3 { display: flex; align-items: center; gap: 10px; margin: 0 0 6px; color: var(--ink); font: 600 19px/1.3 var(--serif); }
	.xfeatures__icon { flex: none; width: 22px; height: 22px; color: var(--gold-dark); }
	.xfeatures__list li:nth-child(3n + 2) .xfeatures__icon { color: #00bf4c; }
	.xfeatures__list li:nth-child(3n + 3) .xfeatures__icon { color: #c8102e; }
	.xfeatures__list p { margin: 0 0 0 32px; color: var(--muted); font-size: 13.5px; font-weight: 300; line-height: 1.7; }
	.xfeatures__note { margin: 30px 0 0; font: italic 500 18px var(--serif); }
	.xfeatures__note a { display: inline-flex; align-items: center; gap: 10px; padding-bottom: 4px; border-bottom: 1px solid var(--gold); color: var(--gold-deep); text-decoration: none; transition: color .2s, border-color .2s; }
	.xfeatures__note a:hover { border-color: var(--gold-deep); color: var(--lake-deep); }
	.xfeatures__arrow { font-style: normal; transition: transform .2s; }
	.xfeatures__note a:hover .xfeatures__arrow { transform: translateX(3px); }

	/* Tour */
	.xtour { padding: 88px 0; background: var(--night); color: var(--paper); }
	.xtour__inner { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; gap: 72px; }
	.xtour h2 { margin: 0; font: 500 clamp(34px, 3.6vw, 50px)/1.08 var(--serif); }
	.xtour__lead { max-width: 50ch; margin: 20px 0 34px; color: #d0dadd; font-size: 15px; font-weight: 300; line-height: 1.8; }
	.xtour__steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 36px; margin: 0; padding: 0; list-style: none; }
	.xtour__steps li { display: flex; gap: 16px; padding-top: 18px; border-top: 1px solid #36505a; }
	.xtour__number { padding-top: 4px; color: var(--gold-light); font-size: 11px; letter-spacing: .1em; }
	.xtour__steps h3 { margin: 0 0 6px; font: 500 22px/1.2 var(--serif); }
	.xtour__steps p { margin: 0; color: #c5d0d3; font-size: 13.5px; font-weight: 300; line-height: 1.7; }
	.xtour__occasions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 40px; }
	.xtour__occasions p { margin: 0; color: var(--gold-light); font: italic 500 18px var(--serif); }
	.xtour__occasions ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
	.xtour__occasions li { padding: 7px 13px; border: 1px solid #3d5862; border-radius: 30px; color: #dfe6e8; font-size: 12px; }
	.xtour__photo { position: relative; margin: 0; }
	.xtour__photo::before { content: ''; position: absolute; inset: -14px 14px 14px -14px; z-index: 0; border: 1px solid rgb(240 217 168 / 35%); border-radius: 200px 200px 0 0; }
	.xtour__photo img { position: relative; z-index: 1; display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 200px 200px 0 0; }

	/* Closing call to action */
	.xcta { padding: 0 0 70px; background: var(--night-2); color: var(--paper); text-align: center; }
	.xcta__lights { margin-bottom: 56px; }
	.xcta h2 { margin: 0; font: 500 clamp(34px, 3.8vw, 52px)/1.1 var(--serif); }
	.xcta__inner > p:not(.xkicker) { max-width: 50ch; margin: 18px auto 30px; color: #d0dadd; font-size: 15px; font-weight: 300; line-height: 1.8; }
	.xcta__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px 28px; }
	.xcta__link { color: var(--gold-light); font-size: 13px; text-underline-offset: 5px; }
	.xcta__link:hover { color: var(--paper); }

	@media (width <= 1000px) {
		.xfeatures__inner { gap: 40px; }
		.xfeatures__list { grid-template-columns: 1fr; gap: 18px; }
		.xtour__inner { gap: 44px; }
		.xtour__steps { grid-template-columns: 1fr; gap: 20px; }
	}
	@media (width <= 860px) {
		.xfeatures__inner, .xtour__inner { grid-template-columns: 1fr; }
		.xcarousel__slides { aspect-ratio: 4 / 3; }
		.xfeatures__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.xtour__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		/* Flatten the copy into the grid so the photo can sit between the heading and the intro. */
		.xtour__inner { gap: 0; }
		.xtour__copy { display: contents; }
		.xtour__photo { order: 1; width: min(100%, 440px); margin: 44px auto 0; }
		.xtour__lead, .xtour__steps, .xtour__occasions { order: 2; }
		.xtour__lead { margin-top: 34px; }
	}
	@media (width <= 760px) {
		.xhero { padding-top: 32px; }
		.xhero::after { height: 70px; }
		.xhero__lights { margin-top: 34px; }
		.xhero__scene img { height: 300px; object-position: 72% center; border-radius: 70px 70px 0 0; }
		.xhero__scene figcaption { right: 32px; bottom: 16px; }
		.xfeatures { padding: 50px 0 56px; }
		.xcarousel__slides { border-bottom-right-radius: 70px; }
		.xcarousel__controls { bottom: 14px; left: 14px; max-width: calc(100% - 90px); }
		.xfeatures__list { grid-template-columns: 1fr; }
		.xtour { padding: 56px 0; }
		.xtour__steps { grid-template-columns: 1fr; }
		.xtour__photo::before { inset: -10px 10px 10px -10px; }
		.xtour__photo img, .xtour__photo::before { border-radius: 140px 140px 0 0; }
		.xcta { padding-bottom: 52px; }
		.xcta__lights { margin-bottom: 42px; }
		.xcta .btn-gold { padding-inline: 18px; letter-spacing: .1em; }
	}
	@media (prefers-reduced-motion: reduce) {
		.xcarousel__slide, .xcarousel__slide.is-active { transition: none; }
	}
	@media (width <= 400px) {
		.xcarousel__status { display: none; }
		.xhero__actions { flex-direction: column; align-items: stretch; }
