---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { footerNav } from '../data/site';
---

<BaseLayout
	title="Page Not Found | Lake Geneva Trolley & Bus Rental"
	description="That page could not be found. Browse the fleet, wedding transportation and services, or request a quote."
	showCtaBand={false}
>
	<PageHeader
		eyebrow="404"
		title="We could not find that page"
		lead="The link may be out of date. Everything on the site is one step away below."
	/>

	<section class="nf">
		<div class="wrap wrap-760">
			<ul class="nf__list">
				{
					footerNav.map((item) => (
						<li>
							<a class="chip" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<p class="nf__cta">
				<a class="btn-gold" href="/#getquote">Request a Quote</a>
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.nf {
		padding: 56px 0 72px;
		text-align: center;
	}

	.nf__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px 14px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nf__list :global(.chip) {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
	}

	.nf__list :global(.chip:hover) {
		border-color: var(--gold);
		color: var(--gold-deep);
	}

	.nf__cta {
		margin: 40px 0 0;
	}
</style>
