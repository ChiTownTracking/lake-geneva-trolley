---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteSection from '../components/home/QuoteSection.astro';
import FleetShowcase from '../components/home/FleetShowcase.astro';
import LocalTransport from '../components/home/LocalTransport.astro';
import WeddingFeature from '../components/home/WeddingFeature.astro';
import ServiceAreas from '../components/home/ServiceAreas.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import PlanCta from '../components/home/PlanCta.astro';
import LocalExperts from '../components/home/LocalExperts.astro';
import PhotoStrip from '../components/home/PhotoStrip.astro';
import { organizationSchema } from '../data/site';
import { homeFaqs } from '../data/home';
---

<BaseLayout
	title="Lake Geneva Trolley Rental for Weddings & Events | Lake Geneva Trolley & Bus Rental"
	description="Lake Geneva trolley rental and group transportation for weddings, events and private outings in Lake Geneva, WI. Compare vehicles and request a quote."
	canonical="/"
	structuredData={organizationSchema()}
	showCtaBand={false}
>
	<Hero />
	<QuoteSection />
	<FleetShowcase />
	<LocalTransport />
	<WeddingFeature />
	<ServiceAreas />
	<Testimonials />
	<Faq
		eyebrow="Frequently Asked Questions"
		title="Trolley Rental in Lake Geneva"
		items={homeFaqs}
		boxed
		tone="red"
	/>
	<PlanCta />
	<LocalExperts />
	<PhotoStrip />
</BaseLayout>
