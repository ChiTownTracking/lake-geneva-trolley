---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../data/content';

/**
 * FAQPage markup describes the questions and answers published on this page.
 * It makes no claim about prices, capacities or policies.
 */
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<BaseLayout
	title="Trolley Rental FAQs | Lake Geneva Trolley & Bus Rental"
	description="Find answers about Lake Geneva trolley rental pricing, wedding transportation, charter stops, chauffeurs and reservations. Plan your private group trip."
	canonical="/faq/"
	structuredData={faqSchema}
>
	<PageHeader
		eyebrow="Frequently Asked"
		title="Questions before you book"
		lead="Learn how Lake Geneva trolley rental works, from quotes and wedding shuttles to chauffeurs and custom routes. Send additional questions with your charter inquiry."
	/>

	<Faq eyebrow="Trolley Questions" title="Everything we get asked" background="paper" />
</BaseLayout>
